# Copy to .env and adjust. Every key is prefixed BOOKSHELF_.

BOOKSHELF_ENVIRONMENT=local           # local | staging | production | test
BOOKSHELF_API_PREFIX=/api/v1

# Persistence
BOOKSHELF_DATABASE_URL=postgresql+psycopg://bookshelf@127.0.0.1:54329/bookshelf  # scripts/pg-local.sh; Supabase: session pooler URL
BOOKSHELF_DATABASE_ECHO=false

# Network guardrails (comma-separated). Both must be explicit in production.
BOOKSHELF_CORS_ORIGINS=http://localhost:4321
BOOKSHELF_ALLOWED_HOSTS=*

# Request guardrails
BOOKSHELF_MAX_REQUEST_BYTES=4194304   # 4 MiB (artifact imports)
BOOKSHELF_RATE_LIMIT_REQUESTS=120     # 0 disables the limiter
BOOKSHELF_RATE_LIMIT_WINDOW_SECONDS=60

# Auth: required in production. When set, every write needs the X-API-Key header.
# Generate one with: python -c "import secrets; print(secrets.token_urlsafe(32))"
BOOKSHELF_API_KEY=

# Observability
BOOKSHELF_LOG_LEVEL=INFO
BOOKSHELF_LOG_JSON=true

# Docs: defaults to on everywhere except production.
# BOOKSHELF_ENABLE_DOCS=true

# Qdrant: set a URL for a cluster; leave unset for the embedded store in ../.qdrant
BOOKSHELF_QDRANT_URL=
BOOKSHELF_QDRANT_API_KEY=

# Model runtime: the Claude Code CLI (D18). No API key lives in the backend.
BOOKSHELF_CLAUDE_BIN=claude
BOOKSHELF_WORKER_CONCURRENCY=2
# Embedded Qdrant (no URL) opens in one process only, so the API runs embed jobs itself;
# false: nothing embeds until a Qdrant URL is configured.
BOOKSHELF_API_EMBED_RUNNER=true
BOOKSHELF_CLAUDE_TIMEOUT_SECONDS=900
BOOKSHELF_MAX_RUNS_PER_DOCUMENT=400   # run ceiling (§14): pause a document after this many CLI runs
# Model per tier (`claude --model` alias or full name); blank keeps haiku / sonnet / opus.
BOOKSHELF_MODEL_EXPLORE=
BOOKSHELF_MODEL_DISTIL=
BOOKSHELF_MODEL_REASON=
# Effort per tier (`claude --effort`): low, medium, high, xhigh or max; blank keeps medium.
BOOKSHELF_EFFORT_EXPLORE=
BOOKSHELF_EFFORT_DISTIL=
BOOKSHELF_EFFORT_REASON=
