# Copy to .env and adjust. Every key is prefixed BOOKSHELF_.

BOOKSHELF_ENVIRONMENT=local           # local | staging | production | test
BOOKSHELF_API_PREFIX=/api/v1

# Persistence
BOOKSHELF_DATABASE_URL=sqlite:///./bookshelf.db
BOOKSHELF_DATABASE_ECHO=false

# Network guardrails (comma-separated). Both must be explicit in production.
BOOKSHELF_CORS_ORIGINS=http://localhost:4321
BOOKSHELF_ALLOWED_HOSTS=*

# Request guardrails
BOOKSHELF_MAX_REQUEST_BYTES=1048576   # 1 MiB
BOOKSHELF_RATE_LIMIT_REQUESTS=120     # 0 disables the limiter
BOOKSHELF_RATE_LIMIT_WINDOW_SECONDS=60

# Auth: required in production. When set, every write needs the X-API-Key header.
# Generate one with: python -c "import secrets; print(secrets.token_urlsafe(32))"
BOOKSHELF_API_KEY=

# Observability
BOOKSHELF_LOG_LEVEL=INFO
BOOKSHELF_LOG_JSON=true

# Docs: defaults to on everywhere except production.
# BOOKSHELF_ENABLE_DOCS=true
