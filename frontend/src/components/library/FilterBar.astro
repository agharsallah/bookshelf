---
/**
 * Library filters as a plain GET form plus tag links: server-rendered, shareable,
 * and working without JavaScript.
 */
import { DOCUMENT_STATUSES } from '../../lib/api/types/documents';
import { pipelineProgress } from '../../lib/documents/pipeline';
import { filterHref, hasFilters, type LibraryFilters } from './filters';

interface Props {
  filters: LibraryFilters;
  tags: { tag: string; count: number }[];
}

const { filters, tags } = Astro.props;
---

<search class="filters">
  <form method="get" action="/library" class="fields">
    <label class="field grow">
      <span>Title</span>
      <input type="search" name="q" value={filters.q ?? ''} placeholder="Words in the title" maxlength="200" />
    </label>
    <label class="field">
      <span>Author</span>
      <input type="text" name="author" value={filters.author ?? ''} placeholder="Any author" maxlength="200" />
    </label>
    <label class="field">
      <span>State</span>
      <select name="status">
        <option value="">Any state</option>
        {DOCUMENT_STATUSES.map((s) => <option value={s} selected={filters.status === s}>{pipelineProgress(s).label}</option>)}
      </select>
    </label>
    {filters.tag && <input type="hidden" name="tag" value={filters.tag} />}
    <div class="buttons">
      <button type="submit">Filter</button>
      {hasFilters(filters) && <a href="/library">Clear filters</a>}
    </div>
  </form>

  {
    tags.length > 0 && (
      <nav class="tags" aria-label="Tags">
        <ul>
          {tags.map(({ tag, count }) => {
            const active = filters.tag === tag;
            return (
              <li>
                <a
                  href={filterHref(filters, { tag: active ? null : tag })}
                  aria-current={active ? 'true' : undefined}
                  title={active ? `Show every tag` : `Only “${tag}”`}
                >
                  {tag}
                  <span class="count">{count}</span>
                </a>
              </li>
            );
          })}
        </ul>
      </nav>
    )
  }
</search>

<style>
  .filters {
    display: grid;
    gap: var(--space-3);
    font-family: var(--font-ui);
    font-size: var(--text-ui);
  }

  .fields {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-end;
    gap: var(--space-3);
  }

  .field {
    display: grid;
    gap: var(--space-1);
    min-width: 10rem;
  }

  .field.grow {
    flex: 1 1 14rem;
  }

  .field span {
    color: var(--ink-3);
    font-size: var(--text-xs);
  }

  input,
  select {
    height: 2.25rem;
    padding: 0 var(--space-3);
    border: 1px solid var(--rule-strong);
    border-radius: var(--radius-m);
    background: var(--paper-raised);
    color: var(--ink);
  }

  input::placeholder {
    color: var(--ink-3);
  }

  .buttons {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    height: 2.25rem;
  }

  button {
    height: 100%;
    padding: 0 var(--space-4);
    border: 0;
    border-radius: var(--radius-m);
    background: var(--ink);
    color: var(--paper);
    font-weight: 600;
    cursor: pointer;
  }

  button:hover {
    background: var(--accent);
  }

  .buttons a {
    color: var(--ink-2);
    font-size: var(--text-sm);
  }

  .tags ul {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .tags a {
    display: inline-flex;
    align-items: baseline;
    gap: var(--space-2);
    padding: var(--space-1) var(--space-3);
    border: 1px solid var(--rule);
    border-radius: 999px;
    color: var(--ink-2);
    font-size: var(--text-sm);
    text-decoration: none;
  }

  .tags a:hover {
    border-color: var(--rule-strong);
    color: var(--ink);
  }

  .tags a[aria-current='true'] {
    border-color: var(--accent);
    background: var(--accent-wash);
    color: var(--ink);
  }

  .count {
    color: var(--ink-3);
    font-size: var(--text-xs);
    font-variant-numeric: tabular-nums;
  }
</style>
