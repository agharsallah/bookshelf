---
/**
 * Library filters and order as a plain GET form plus tag links: server-rendered,
 * shareable, and working without JavaScript. With JavaScript (`live.ts`) they apply
 * as you type, the tag chips toggle in place and the Filter button goes away. The
 * pipeline-state filter is for workshop mode only.
 */
import { DOCUMENT_STATUSES } from '../../lib/api/types/documents';
import { pipelineProgress } from '../../lib/documents/pipeline';
import { libraryHref, type LibraryFilters } from './filters';
import { SORTS, type Sort } from './sort';

interface Props {
  filters: LibraryFilters;
  sort: Sort;
  tags: { tag: string; count: number }[];
}

const { filters, sort, tags } = Astro.props;
---

<search class="filters">
  <form method="get" action="/library" class="fields" data-filters>
    <label class="field grow">
      <span>Title</span>
      <input
        type="search"
        name="q"
        value={filters.q ?? ''}
        placeholder="Words in the title"
        maxlength="200"
        autocomplete="off"
      />
    </label>
    <label class="field">
      <span>Author</span>
      <input type="text" name="author" value={filters.author ?? ''} placeholder="Any author" maxlength="200" autocomplete="off" />
    </label>
    <label class="field workshop-only">
      <span>State</span>
      <select name="status">
        <option value="">Any state</option>
        {DOCUMENT_STATUSES.map((s) => <option value={s} selected={filters.status === s}>{pipelineProgress(s).label}</option>)}
      </select>
    </label>
    <label class="field">
      <span>Sort by</span>
      <select name="sort">
        {SORTS.map((s) => <option value={s.value} selected={sort === s.value}>{s.label}</option>)}
      </select>
    </label>
    <input type="hidden" name="tag" value={filters.tag ?? ''} />
    <button type="submit" class="btn" data-apply>Filter</button>
  </form>

  {
    tags.length > 0 && (
      <nav class="tags" aria-label="Tags">
        <ul>
          {tags.map(({ tag, count }) => {
            const active = filters.tag === tag;
            return (
              <li>
                <a
                  href={libraryHref({ ...filters, tag: active ? null : tag }, sort)}
                  aria-current={active ? 'true' : undefined}
                  data-tag={tag}
                >
                  {tag}
                  <span class="count">{count}</span>
                </a>
              </li>
            );
          })}
        </ul>
      </nav>
    )
  }
</search>

<style>
  .filters {
    display: grid;
    gap: var(--space-3);
    font-family: var(--font-ui);
    font-size: var(--text-ui);
  }

  .fields {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-end;
    gap: var(--space-3);
  }

  .field {
    display: grid;
    flex: 0 1 12rem;
    gap: var(--space-1);
    min-width: 9rem;
  }

  .field.grow {
    flex: 1 1 16rem;
  }

  .field span {
    color: var(--ink-2);
    font-size: var(--text-sm);
  }

  input,
  select {
    width: 100%;
    min-width: 0;
    height: 2.5rem;
    padding: 0 var(--space-3);
    border: 1px solid var(--rule-strong);
    border-radius: var(--radius-m);
    background: var(--paper-raised);
    color: var(--ink);
    font: inherit;
  }

  input:hover,
  select:hover {
    border-color: var(--ink-3);
  }

  input::placeholder {
    color: var(--ink-3);
  }

  /* `.btn` sets a display; the script hides the button once filters apply live. */
  [data-apply][hidden] {
    display: none;
  }

  .tags ul {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .tags a {
    display: inline-flex;
    align-items: baseline;
    gap: var(--space-2);
    padding: var(--space-1) var(--space-3);
    border: 1px solid var(--rule);
    border-radius: var(--radius-pill);
    color: var(--ink-2);
    font-size: var(--text-sm);
    text-decoration: none;
    transition:
      background var(--dur-1) var(--ease-out),
      border-color var(--dur-1) var(--ease-out);
  }

  .tags a:hover {
    border-color: var(--rule-strong);
    color: var(--ink);
  }

  .tags a[aria-current='true'] {
    border-color: var(--accent);
    background: var(--accent-wash);
    color: var(--ink);
  }

  .count {
    color: var(--ink-3);
    font-size: var(--text-xs);
    font-variant-numeric: tabular-nums;
  }

  @media (max-width: 40rem) {
    .field {
      flex: 1 1 9rem;
    }

    .field.grow {
      flex-basis: 100%;
    }
  }
</style>
