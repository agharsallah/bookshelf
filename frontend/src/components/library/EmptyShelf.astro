---
/** An empty shelf teaches the flow: drop a file in library/, add it, read it. */
interface Props {
  filtered: boolean;
}

const { filtered } = Astro.props;
---

{
  filtered ? (
    <div class="empty">
      <p class="lead">Nothing on the shelf matches these filters.</p>
      <p>
        <a href="/library">Show the whole shelf</a>
      </p>
    </div>
  ) : (
    <div class="empty">
      <p class="lead">Your shelf is empty.</p>
      <ol class="flow">
        <li>
          <span class="step">Drop a PDF, HTML or Markdown file into</span> <code>library/</code> at the root of
          the repository.
        </li>
        <li>
          <span class="step">Add it to the shelf</span> from the list above, or paste an article’s URL.
        </li>
        <li>
          <span class="step">Read it</span> once parsing finishes: chapters, figures and tables, with your
          highlights and notes beside the text.
        </li>
      </ol>
    </div>
  )
}

<style>
  .empty {
    display: grid;
    gap: var(--space-4);
    max-width: 38rem;
    padding: var(--space-7) 0 var(--space-6);
    border-block-end: var(--space-2) solid light-dark(#a88f64, #2a241b);
  }

  .lead {
    font-size: var(--text-lg);
    line-height: var(--leading-tight);
  }

  .flow {
    display: grid;
    gap: var(--space-3);
    padding-inline-start: 1.4em;
    color: var(--ink-2);
  }

  .flow li::marker {
    color: var(--accent);
    font-family: var(--font-ui);
    font-weight: 600;
  }

  .step {
    color: var(--ink);
  }
</style>
