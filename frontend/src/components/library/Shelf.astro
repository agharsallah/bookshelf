---
/**
 * The shelf view: books stand as spines in rows, each row resting on a plank. Rows
 * have a fixed height (a little taller than the tallest spine, so a lifted book stays
 * inside its row), so the planks can be drawn as one repeating background. Grouped,
 * a divider card stands before each group, tab in the group's dye, like the dividers
 * in a record shop; the cards of every dimension are rendered and the library's
 * classes show the ones in use (`library.css`).
 */
import Spine from './Spine.astro';
import type { Palette } from './facets';
import { dividerCards, type LibraryItem } from './items';

interface Props {
  items: LibraryItem[];
  label: string;
  /** The book on the lectern. */
  selected: string | null;
  /** The shelf's buckets, for the divider cards. */
  palette: Palette;
}

const { items, label, selected, palette } = Astro.props;
---

<ul class="shelf" aria-label={label} data-books>
  {items.map((item, index) => <Spine index={index} selected={item.doc.slug === selected} {...item} />)}
  {
    dividerCards(palette, items).map((card) => (
      <li
        class="divider"
        data-divider={card.dimension}
        data-bucket={card.bucket}
        data-index={card.index}
        style={`--g:${card.index};--tab:${card.dye}`}
        hidden={card.count === 0}
      >
        <span class="tab" aria-hidden="true"></span>
        <span class="divider-label">{card.label}</span>
        <span class="divider-count" data-divider-count>{card.count}</span>
      </li>
    ))
  }
</ul>

<style>
  .shelf {
    --row: 20.5rem;
    --plank: 0.8rem;
    --gap: 2.25rem;
    --plank-top: light-dark(#c9b58f, #3a3226);
    --plank-face: light-dark(#a88f64, #2a241b);
    display: flex;
    flex-wrap: wrap;
    align-items: flex-end;
    gap: var(--gap) 3px;
    min-block-size: calc(var(--row) + var(--plank));
    margin: 0;
    padding: 0 var(--space-3) var(--plank);
    background: repeating-linear-gradient(
      to bottom,
      transparent 0 var(--row),
      var(--plank-top) var(--row) calc(var(--row) + 0.2rem),
      var(--plank-face) calc(var(--row) + 0.2rem) calc(var(--row) + var(--plank)),
      rgb(0 0 0 / 0.08) calc(var(--row) + var(--plank)) calc(var(--row) + var(--plank) + 0.35rem),
      transparent calc(var(--row) + var(--plank) + 0.35rem) calc(var(--row) + var(--gap))
    );
  }

  .shelf > :global(li) {
    height: var(--row);
  }

  /* ── Divider cards ─────────────────────────────────────────── */
  .divider {
    position: relative;
    display: none;
    flex-direction: column;
    align-items: center;
    justify-content: flex-end;
    gap: var(--space-2);
    list-style: none;
  }

  :global(.group-on.by-kind) .divider[data-divider='kind']:not([hidden]),
  :global(.group-on.by-reading) .divider[data-divider='reading']:not([hidden]),
  :global(.group-on.by-study) .divider[data-divider='study']:not([hidden]),
  :global(.group-on.by-theme) .divider[data-divider='theme']:not([hidden]) {
    display: flex;
  }

  /* Only a new group after the first needs room from the books before it. */
  .divider ~ .divider:not([hidden]) {
    margin-inline-start: var(--space-4);
  }

  .divider::before {
    content: '';
    position: absolute;
    inset: auto 0 0;
    height: 13.5rem;
    border: 1px solid var(--rule-strong);
    border-radius: 2px 2px 0 0;
    background: var(--paper-raised);
    box-shadow: 1px 0 0 rgb(0 0 0 / 0.06);
  }

  .tab {
    position: absolute;
    inset-block-end: calc(13.5rem - 1px);
    inset-inline-start: 0.25rem;
    width: calc(100% - 0.5rem);
    height: 1.4rem;
    border-radius: 4px 4px 0 0;
    background: var(--tab);
  }

  .divider-label,
  .divider-count {
    position: relative;
    font-family: var(--font-ui);
  }

  .divider-label {
    writing-mode: vertical-rl;
    rotate: 180deg;
    color: var(--ink);
    font-size: var(--text-sm);
    font-weight: 650;
    letter-spacing: 0.01em;
  }

  .divider-count {
    min-inline-size: 1.4rem;
    margin-block-end: var(--space-2);
    padding: 0.1rem 0.3rem;
    border-radius: var(--radius-pill);
    background: var(--tab);
    color: #f5efe0;
    font-size: var(--text-xs);
    font-weight: 600;
    font-variant-numeric: tabular-nums;
    text-align: center;
  }

  .divider {
    width: 2.3rem;
    padding-block-end: var(--space-1);
  }

  @media (max-width: 40rem) {
    .shelf {
      flex-direction: column;
      align-items: stretch;
      gap: 2px;
      min-block-size: 0;
      padding: var(--space-3) 0 var(--plank);
      background: none;
      border-block-end: var(--plank) solid var(--plank-face);
    }

    .shelf > :global(li) {
      height: auto;
    }

    /* Lying flat, a divider is a card edge with its label along it. */
    .divider {
      flex-direction: row;
      justify-content: space-between;
      width: auto;
      margin-block-start: var(--space-3);
      padding: var(--space-2) var(--space-3);
      border-inline-start: 0.4rem solid var(--tab);
      border-radius: 2px;
      background: var(--paper-raised);
      box-shadow: inset 0 0 0 1px var(--rule-strong);
    }

    .divider ~ .divider:not([hidden]) {
      margin-inline-start: 0;
    }

    .divider::before,
    .tab {
      display: none;
    }

    .divider-label {
      writing-mode: horizontal-tb;
      rotate: none;
    }

    .divider-count {
      margin: 0;
    }
  }
</style>
