---
/**
 * The shelf at a glance, and the key to its colours, in two lines. The first picks the
 * dimension that dyes the spines (kind, reading, study material, theme); each choice
 * carries a small bar of that dimension's buckets, so every breakdown shows at once.
 * The second is the chosen dimension's legend: each bucket with its count links to the
 * shelf filtered to it (and back), and pointing at one lights its books (`live-display.ts`).
 * Every dimension's legend is rendered; the library's `by-*` class shows the chosen one.
 */
import { DIMENSION_LABELS, DIMENSIONS, DYES, FACET_FILTERS, facet, NO_THEME, type Palette } from './facets';
import { libraryHref, type LibraryFilters } from './filters';
import type { LibraryItem } from './items';
import type { Sort } from './sort';

interface Props {
  items: LibraryItem[];
  filters: LibraryFilters;
  sort: Sort;
  palette: Palette;
}

const { items, filters, sort, palette } = Astro.props;
const books = items.map((item) => item.buckets);
const unthemed = items.every((item) => item.buckets.theme === NO_THEME);
const facets = DIMENSIONS.map((dimension) => ({ dimension, key: FACET_FILTERS[dimension], segments: facet(palette, dimension, books) }));
---

<section class="overview" aria-labelledby="overview-title">
  <div class="dims" role="group" aria-labelledby="overview-title" data-needs-script>
    <h2 id="overview-title" class="dims-title">Colour by</h2>
    {
      facets.map(({ dimension, segments }) => (
        <button type="button" class="dim" data-by={dimension} aria-pressed="false">
          {DIMENSION_LABELS[dimension]}
          <span class="mini" aria-hidden="true">
            {segments
              .filter((s) => s.count > 0)
              .map((s) => (
                <span style={`--dye:${DYES[s.dye]};flex-grow:${s.count}`} />
              ))}
          </span>
        </button>
      ))
    }
  </div>

  {
    facets.map(({ dimension, key, segments }) => {
      const active = filters[key];
      return (
        <div class="facet" data-facet={dimension} data-filtered={active ? '' : undefined}>
          <h3 class="facet-title">{DIMENSION_LABELS[dimension]}</h3>
          <div class="bar" aria-hidden="true">
            {segments
              .filter((s) => s.count > 0)
              .map((s, i) => (
                <span
                  class="segment"
                  data-segment={s.value}
                  data-active={active === s.value ? '' : undefined}
                  style={`--dye:${DYES[s.dye]};flex-grow:${s.count};--i:${i}`}
                />
              ))}
          </div>
          <ul class="legend">
            {segments.map((s) => (
              <li>
                <a
                  href={libraryHref({ ...filters, [key]: active === s.value ? null : s.value }, sort)}
                  data-facet-filter={key}
                  data-value={s.value}
                  data-dimension={dimension}
                  aria-current={active === s.value ? 'true' : undefined}
                  data-empty={s.count === 0 ? '' : undefined}
                  style={`--dye:${DYES[s.dye]}`}
                >
                  <span class="swatch" aria-hidden="true" />
                  {s.label}
                  <span class="n">{s.count}</span>
                </a>
              </li>
            ))}
          </ul>
          {dimension === 'theme' && unthemed && (
            <p class="hint">Themes come from each book's library card, written by the catalogue-document skill.</p>
          )}
        </div>
      );
    })
  }
</section>

<style>
  .overview {
    display: grid;
    gap: var(--space-3);
    padding-block: var(--space-3) var(--space-4);
    border-block: 1px solid var(--rule);
    font-family: var(--font-ui);
  }

  /* ── Colour by ─────────────────────────────────────────────── */
  .dims {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-2);
  }

  .dims-title {
    margin-inline-end: var(--space-1);
    color: var(--ink-3);
    font-family: var(--font-ui);
    font-size: var(--text-sm);
    font-weight: 500;
  }

  .dim {
    display: inline-grid;
    gap: 0.3rem;
    min-inline-size: 7.5rem;
    padding: var(--space-2) var(--space-3);
    border: 1px solid var(--rule-strong);
    border-radius: var(--radius-m);
    background: var(--paper-raised);
    color: var(--ink-2);
    font: inherit;
    font-size: var(--text-sm);
    font-weight: 600;
    text-align: start;
    cursor: pointer;
    transition:
      border-color var(--dur-1) var(--ease-out),
      color var(--dur-1) var(--ease-out),
      background var(--dur-1) var(--ease-out);
  }

  .dim:hover {
    border-color: var(--ink-3);
    color: var(--ink);
  }

  :global(.by-kind) .dim[data-by='kind'],
  :global(.by-reading) .dim[data-by='reading'],
  :global(.by-study) .dim[data-by='study'],
  :global(.by-theme) .dim[data-by='theme'] {
    border-color: var(--ink);
    box-shadow: inset 0 0 0 1px var(--ink);
    color: var(--ink);
    cursor: default;
  }

  /* Each choice's own breakdown, in its dyes: every dimension at a glance. */
  .mini {
    display: flex;
    gap: 1px;
    block-size: 0.3rem;
    overflow: hidden;
    border-radius: var(--radius-pill);
    background: var(--rule);
  }

  .mini > span {
    flex-basis: 0;
    min-inline-size: 0.2rem;
    background: var(--dye);
  }

  /* ── The chosen dimension's key ────────────────────────────── */
  .facet {
    display: none;
    grid-template-columns: minmax(8rem, 16rem) minmax(0, 1fr);
    align-items: center;
    gap: var(--space-2) var(--space-5);
  }

  :global(.by-kind) .facet[data-facet='kind'],
  :global(.by-reading) .facet[data-facet='reading'],
  :global(.by-study) .facet[data-facet='study'],
  :global(.by-theme) .facet[data-facet='theme'] {
    display: grid;
  }

  /* Without the script there is no choosing: the key says what it is a key to. */
  .facet-title {
    display: none;
    grid-column: 1 / -1;
    font-family: var(--font-ui);
    font-size: var(--text-sm);
    font-weight: 650;
  }

  :global(.library:not([data-live])) .facet-title {
    display: block;
  }

  .bar {
    display: flex;
    gap: 2px;
    block-size: 0.75rem;
    overflow: hidden;
    border-radius: 3px;
    background: var(--rule);
  }

  .segment {
    flex-basis: 0;
    min-inline-size: 0.5rem;
    background: var(--dye);
    cursor: pointer;
    transform-origin: left;
    animation: grow var(--dur-4) var(--ease-stroke) both;
    animation-delay: calc(var(--i) * 90ms + var(--dur-2));
    transition: opacity var(--dur-2) var(--ease-out);
  }

  @keyframes grow {
    from { scale: 0 1; }
  }

  /* A filter on this dimension, or a bucket under the pointer: the others step back. */
  .facet[data-filtered] .segment:not([data-active]),
  .facet:has(.legend a:is(:hover, :focus-visible)) .segment:not([data-lit]) {
    opacity: 0.3;
  }

  .legend {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-1);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .legend a {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    padding: 0.2rem var(--space-2);
    border: 1px solid transparent;
    border-radius: var(--radius-m);
    color: var(--ink-2);
    font-size: var(--text-sm);
    text-decoration: none;
    transition:
      background var(--dur-1) var(--ease-out),
      border-color var(--dur-1) var(--ease-out);
  }

  .legend a:hover {
    background: var(--paper-sunken);
    color: var(--ink);
  }

  .legend a[aria-current='true'] {
    border-color: var(--ink);
    color: var(--ink);
    font-weight: 600;
  }

  .legend a[data-empty] {
    color: var(--ink-3);
  }

  .swatch {
    inline-size: 0.7rem;
    block-size: 0.7rem;
    border-radius: 2px;
    background: var(--dye);
  }

  .legend a[data-empty] .swatch {
    background: transparent;
    box-shadow: inset 0 0 0 1px var(--rule-strong);
  }

  .n {
    color: var(--ink-3);
    font-size: var(--text-xs);
    font-variant-numeric: tabular-nums;
  }

  .hint {
    grid-column: 1 / -1;
    color: var(--ink-3);
    font-size: var(--text-xs);
  }

  @media (max-width: 44rem) {
    .facet {
      grid-template-columns: minmax(0, 1fr);
    }

    .dim {
      min-inline-size: 0;
      flex: 1 1 6rem;
    }
  }
</style>
