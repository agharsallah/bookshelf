---
/**
 * "Add a book": opens the ingest dialog. Uses the platform's invoker commands
 * (`commandfor` / `command="show-modal"`), with a script fallback in `live.ts` for
 * browsers without them. The dialog moves focus in, closes on Esc and hands focus back.
 */
import { ADD_BOOK_DIALOG } from './live-ids';

interface Props {
  /** Files already waiting in `library/`, shown as a count on the button. */
  waiting?: number;
}

const { waiting = 0 } = Astro.props;
---

<button
  type="button"
  class="btn btn-primary add"
  commandfor={ADD_BOOK_DIALOG}
  command="show-modal"
  aria-haspopup="dialog"
  data-add-book
  data-demo-off
>
  Add a book
  {waiting > 0 && <span class="waiting">{waiting} waiting</span>}
</button>

<style>
  .add {
    flex: none;
  }

  .waiting {
    padding: 0.1rem var(--space-2);
    border-radius: var(--radius-pill);
    background: color-mix(in oklab, var(--on-accent) 22%, transparent);
    font-size: var(--text-xs);
    font-weight: 600;
    font-variant-numeric: tabular-nums;
  }
</style>
