---
/**
 * Shelf or list. The pressed look follows the library's `view-*` class (set before
 * first paint), so a stored choice never flashes; `live.ts` keeps `aria-pressed` in
 * step and remembers the choice. Hidden without JavaScript, where it could not work.
 */
import { DEFAULT_VIEW, VIEWS } from './view';

const LABELS = { shelf: 'Shelf', list: 'List' } as const;
---

<div class="views" role="group" aria-label="Show as" data-views>
  {
    VIEWS.map((view) => (
      <button type="button" data-view={view} aria-pressed={view === DEFAULT_VIEW ? 'true' : 'false'}>
        {view === 'shelf' ? (
          <svg viewBox="0 0 16 16" width="16" height="16" aria-hidden="true">
            <path d="M2.5 13.5v-9h2.5v9M6.5 13.5v-11h2.5v11M10.5 13.5l1.2-8.2 2.4.4-1.2 7.8" fill="none" stroke="currentColor" stroke-width="1.3" stroke-linejoin="round" />
          </svg>
        ) : (
          <svg viewBox="0 0 16 16" width="16" height="16" aria-hidden="true">
            <path d="M2.5 4h1M6 4h7.5M2.5 8h1M6 8h7.5M2.5 12h1M6 12h7.5" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" />
          </svg>
        )}
        {LABELS[view]}
      </button>
    ))
  }
</div>
<noscript><style>[data-views] { display: none !important; }</style></noscript>

<style>
  .views {
    display: inline-flex;
    padding: 2px;
    border: 1px solid var(--rule-strong);
    border-radius: var(--radius-m);
    font-family: var(--font-ui);
    font-size: var(--text-sm);
  }

  button {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    min-block-size: 2.25rem;
    padding: 0 var(--space-3);
    border: 0;
    border-radius: calc(var(--radius-m) - 2px);
    background: transparent;
    color: var(--ink-2);
    font: inherit;
    font-weight: 600;
    cursor: pointer;
    transition:
      background var(--dur-1) var(--ease-out),
      color var(--dur-1) var(--ease-out);
  }

  button:hover {
    color: var(--ink);
  }

  :global(.view-shelf) [data-view='shelf'],
  :global(.view-list) [data-view='list'] {
    background: var(--ink);
    color: var(--paper);
  }
</style>
