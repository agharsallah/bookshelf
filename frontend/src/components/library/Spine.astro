---
/**
 * One document standing on the shelf: a cloth spine with its title and author, a
 * call-number label at the foot whose five notches are the pipeline milestones,
 * and a paper slip sticking out of the top when drafts wait for review. Hover or
 * focus shows the catalogue card (anchored to the spine where CSS anchor
 * positioning exists). On narrow screens the book lies flat and shows it all inline.
 */
import type { DocumentSummary } from '../../lib/api/types/documents';
import { pipelineProgress, PIPELINE_STEPS, stepState } from '../../lib/documents/pipeline';
import { plural, spineAuthor, spineLook, waitingReview } from './spine';

interface Props {
  doc: DocumentSummary;
  index: number;
}

const { doc, index } = Astro.props;
const look = spineLook(doc);
const progress = pipelineProgress(doc.status);
const waiting = waitingReview(doc);
const cardId = `card-${doc.id}`;
const anchorName = `--spine-${index}`;
const counts = [
  doc.counts.chapters ? plural(doc.counts.chapters, 'chapter') : null,
  doc.counts.figures ? plural(doc.counts.figures, 'figure') : null,
  doc.counts.notes ? plural(doc.counts.notes, 'note') : null,
].filter(Boolean);
const facts = [doc.year, doc.kind === 'article' ? 'Article' : doc.page_count ? `${doc.page_count} pages` : null]
  .filter(Boolean)
  .join(', ');
---

<li class="book" data-cloth={look.cloth} data-kind={doc.kind}>
  <a
    class="spine"
    href={`/documents/${doc.slug}`}
    aria-describedby={cardId}
    style={`--w:${look.width}rem;--h:${look.height}rem;anchor-name:${anchorName}`}
  >
    {waiting > 0 && <span class="slip" aria-hidden="true"></span>}
    <span class="band" aria-hidden="true"></span>
    <span class="title">{doc.title}</span>
    <span class="author">{spineAuthor(doc.authors)}</span>
    <span class="label" aria-hidden="true">
      <span class="year">{doc.year ?? ''}</span>
      <span class="notches" data-attention={progress.attention ?? undefined}>
        {PIPELINE_STEPS.map((_, i) => <span class="notch" data-state={stepState(doc.status, i)} />)}
      </span>
    </span>
    <span class="flat-meta" aria-hidden="true">
      {[doc.authors.join(', '), facts].filter(Boolean).join('; ')}
    </span>
  </a>

  <div class="card" id={cardId} role="note" style={`position-anchor:${anchorName}`}>
    <p class="card-title">{doc.title}</p>
    {doc.authors.length > 0 && <p class="card-authors">{doc.authors.join(', ')}</p>}
    {facts && <p class="card-facts">{facts}</p>}
    <p class="card-status" data-attention={progress.attention ?? undefined}>{progress.label}</p>
    {counts.length > 0 && <p class="card-counts">{counts.join(', ')}</p>}
    {waiting > 0 && <p class="card-waiting">{plural(waiting, 'draft')} waiting for review</p>}
    {doc.tags.length > 0 && (
      <p class="card-tags">
        {doc.tags.map((tag) => <span>{tag}</span>)}
      </p>
    )}
  </div>
</li>

<style>
  .book {
    /* Cloths: dark enough for paper-coloured type in both themes (≥ 7:1). */
    --cloth: #6d2a2a;
    --gilt: color-mix(in oklab, #e9d9a8 80%, var(--cloth));
    /* Not positioned: the anchored card must be able to leave the book's box. */
    display: flex;
    align-items: flex-end;
    list-style: none;
  }

  .book[data-cloth='navy'] { --cloth: #25355a; }
  .book[data-cloth='forest'] { --cloth: #2c4a37; }
  .book[data-cloth='ochre'] { --cloth: #6e4f16; }
  .book[data-cloth='slate'] { --cloth: #3b4450; }
  .book[data-cloth='plum'] { --cloth: #4e2c4d; }
  .book[data-cloth='teal'] { --cloth: #1d4f52; }

  .spine {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--space-2);
    width: var(--w);
    height: var(--h);
    padding: var(--space-3) 0 var(--space-2);
    border-radius: 3px 3px 1px 1px;
    background:
      linear-gradient(90deg, rgb(0 0 0 / 0.22), transparent 18%, rgb(255 255 255 / 0.07) 45%, transparent 70%, rgb(0 0 0 / 0.25)),
      var(--cloth);
    box-shadow: inset 0 -1px 0 rgb(0 0 0 / 0.3), 1px 0 0 rgb(0 0 0 / 0.18);
    color: #f5efe0;
    text-decoration: none;
    transition: translate var(--dur-2) var(--ease-out);
  }

  .book[data-kind='article'] .spine {
    border-radius: 1px;
  }

  .spine:hover,
  .spine:focus-visible {
    translate: 0 -0.5rem;
  }

  .spine:focus-visible {
    outline-offset: 3px;
  }

  .band {
    flex: none;
    width: 70%;
    height: 0.4rem;
    border-block: 1px solid var(--gilt);
    opacity: 0.8;
  }

  .title {
    flex: 1 1 auto;
    min-height: 0;
    overflow: hidden;
    writing-mode: vertical-rl;
    font-family: var(--font-read);
    font-size: 0.95rem;
    font-weight: 520;
    line-height: 1.15;
    letter-spacing: 0.01em;
    /* One line; the full title is on the catalogue card. */
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .author {
    flex: none;
    max-height: 5.5rem;
    overflow: hidden;
    writing-mode: vertical-rl;
    color: var(--gilt);
    font-family: var(--font-read);
    font-size: 0.72rem;
    font-style: italic;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  /* The library's call-number sticker; its notches are the pipeline milestones. */
  .label {
    flex: none;
    display: grid;
    justify-items: center;
    gap: 3px;
    width: calc(100% - 0.7rem);
    min-width: 1.7rem;
    padding: 0.25rem 0.15rem 0.3rem;
    border-radius: 2px;
    background: #f4efe2;
    color: #2a2f3c;
    font-family: var(--font-ui);
    font-size: 0.62rem;
    font-variant-numeric: tabular-nums;
    line-height: 1;
  }

  .year:empty {
    display: none;
  }

  .notches {
    display: flex;
    gap: 2px;
  }

  .notch {
    width: 3px;
    height: 7px;
    border-radius: 1px;
    background: #d6ccb4;
  }

  .notch[data-state='done'],
  .notch[data-state='current'] {
    background: #1e6b5c;
  }

  .notch[data-state='working'] {
    background: #1e6b5c;
    animation: breathe 1.6s var(--ease-out) infinite alternate;
  }

  .notch[data-state='review'] {
    background: #b27a12;
  }

  .notch[data-state='failed'] {
    background: #9b2f22;
  }

  @keyframes breathe {
    from { opacity: 0.35; }
    to { opacity: 1; }
  }

  .slip {
    position: absolute;
    inset-block-start: -0.85rem;
    inset-inline-end: 22%;
    width: 0.7rem;
    height: 1.4rem;
    border-radius: 1px 1px 0 0;
    background: var(--paper-raised);
    box-shadow: 0 0 0 1px var(--rule);
    rotate: 3deg;
  }

  .flat-meta {
    display: none;
  }

  /* ── Catalogue card ─────────────────────────────────────────── */
  .card {
    display: none;
  }

  @supports (anchor-name: --a) {
    .card {
      position: absolute;
      position-area: top span-right;
      position-try-fallbacks: top span-left, bottom span-right, bottom span-left;
      z-index: 5;
      display: block;
      width: max-content;
      max-width: min(19rem, 80vw);
      margin: var(--space-2) 0;
      padding: var(--space-3) var(--space-4);
      border: 1px solid var(--rule);
      border-radius: var(--radius-l);
      background: var(--paper-raised);
      box-shadow: var(--shadow-lift);
      font-family: var(--font-ui);
      font-size: var(--text-sm);
      line-height: var(--leading-ui);
      opacity: 0;
      pointer-events: none;
      visibility: hidden;
      transition: opacity var(--dur-2) var(--ease-out), visibility 0s linear var(--dur-2);
    }

    .spine:hover + .card,
    .spine:focus-visible + .card {
      opacity: 1;
      visibility: visible;
      transition-delay: 0s;
    }
  }

  .card p + p {
    margin-block-start: var(--space-1);
  }

  .card-title {
    color: var(--ink);
    font-family: var(--font-read);
    font-size: var(--text-ui);
    font-weight: 560;
    line-height: var(--leading-tight);
  }

  .card-authors,
  .card-facts,
  .card-counts {
    color: var(--ink-2);
  }

  .card-status {
    color: var(--accent);
  }

  .card-status[data-attention='review'],
  .card-waiting {
    color: var(--tone-caution);
  }

  .card-status[data-attention='failed'] {
    color: var(--tone-important);
  }

  .card-tags {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-1);
  }

  .card-tags span {
    padding: 0 var(--space-2);
    border-radius: 999px;
    background: var(--paper-sunken);
    color: var(--ink-2);
    font-size: var(--text-xs);
  }

  /* ── Narrow screens: the books lie flat in a pile ───────────── */
  @media (max-width: 40rem) {
    .book {
      display: block;
    }

    .spine {
      display: grid;
      grid-template-columns: 1fr auto;
      grid-template-areas: 'title label' 'meta label';
      align-items: center;
      gap: 0 var(--space-3);
      width: calc(100% - var(--offset, 0rem));
      height: auto;
      min-height: calc(var(--w) + 0.6rem);
      margin-inline-start: var(--offset, 0rem);
      padding: var(--space-2) var(--space-3);
      border-radius: 1px 3px 3px 1px;
      background:
        linear-gradient(180deg, rgb(255 255 255 / 0.08), transparent 40%, rgb(0 0 0 / 0.22)),
        var(--cloth);
    }

    .spine:hover,
    .spine:focus-visible {
      translate: 0.35rem 0;
    }

    .band,
    .author,
    .slip {
      display: none;
    }

    .title {
      grid-area: title;
      writing-mode: horizontal-tb;
      white-space: normal;
      display: -webkit-box;
      -webkit-line-clamp: 2;
      -webkit-box-orient: vertical;
    }

    .flat-meta {
      grid-area: meta;
      display: block;
      overflow: hidden;
      color: var(--gilt);
      font-family: var(--font-read);
      font-size: 0.78rem;
      font-style: italic;
      text-overflow: ellipsis;
      white-space: nowrap;
    }

    .label {
      grid-area: label;
      width: auto;
    }

    .book:nth-child(3n + 2) { --offset: 0.6rem; }
    .book:nth-child(3n) { --offset: 0.25rem; }

    @supports (anchor-name: --a) {
      .card {
        display: none;
      }
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .notch[data-state='working'] {
      animation: none;
    }
  }

  @media (forced-colors: active) {
    .spine {
      border: 1px solid CanvasText;
    }
  }
</style>
