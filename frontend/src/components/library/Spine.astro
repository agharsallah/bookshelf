---
/**
 * One book standing on the shelf: a cloth spine dyed by the chosen dimension, its short
 * title set to fit, the author, and a call-number sticker showing what the shelf is
 * sorted by (year, share read or length). A highlighter edge rises up the spine as the
 * book is read, and the book read most recently wears the ribbon. The spine is a link to
 * the book's page; pointing at it (or focusing it) shows the book on the lectern. In
 * workshop mode the sticker's
 * notches show the pipeline milestones and a paper slip sticks out when drafts wait
 * for review. On narrow screens the books lie flat and show their full titles.
 */
import { pipelineProgress, PIPELINE_STEPS, stepState } from '../../lib/documents/pipeline';
import { bookAttributes } from './book-data';
import { dyeStyle, placeStyle } from './book-style';
import type { LibraryItem } from './items';
import { LECTERN } from './live-ids';
import { readingLabel } from './progress';
import { pagesOf, spineAuthor, spineLook, titleFit, waitingReview } from './spine';
import styles from './Spine.module.css';

type Props = LibraryItem & {
  index: number;
  /** On the lectern now. */
  selected: boolean;
};

const { doc, collections, index, reading, buckets, colours, keys, current, hidden, selected } = Astro.props;
const look = spineLook(doc);
const fit = titleFit(doc.title, doc.authors, look);
const progress = pipelineProgress(doc.status);
const waiting = waitingReview(doc);
const pages = pagesOf(doc);
const read = readingLabel(reading);
const stickers = {
  year: doc.year ? String(doc.year) : '',
  progress: reading.lastRead ? `${Math.round(reading.share * 100)}%` : '',
  length: pages.pages ? `${pages.estimated ? '~' : ''}${pages.pages}p` : '',
};
const facts = [doc.year, doc.kind === 'article' ? 'Article' : pages.pages ? `${pages.pages} pages` : null].filter(Boolean).join(', ');
---

<li
  class={styles.book}
  style={`${dyeStyle(colours, look.shade)};${placeStyle(doc.id, colours, index)}`}
  data-dyed
  data-kind={doc.kind}
  data-current={current ? '' : undefined}
  hidden={hidden}
  {...bookAttributes(doc, buckets, keys, collections)}
>
  <a
    class={styles.spine}
    href={`/documents/${doc.slug}`}
    aria-controls={LECTERN}
    aria-current={selected ? 'true' : undefined}
    data-spine
    style={`--w:${look.width}rem;--h:${fit.height}rem;--ts:${fit.size}rem;--share:${reading.lastRead ? reading.share : 0}`}
  >
    {current && <span class={styles.ribbon} aria-hidden="true"></span>}
    {waiting > 0 && <span class:list={[styles.slip, 'workshop-only']} aria-hidden="true"></span>}
    <span class={styles.band} aria-hidden="true"></span>
    <span class={styles.title} data-clipped={fit.clipped ? '' : undefined}>{fit.text}</span>
    <span class={styles.flatTitle}>{doc.title}</span>
    <span class={styles.author}>{spineAuthor(doc.authors)}</span>
    <span class="visually-hidden">, {current ? `reading now, ${read.toLowerCase()}` : read.toLowerCase()}</span>
    <span class={styles.label} aria-hidden="true">
      {
        Object.entries(stickers).map(([sticker, text]) => (
          <span data-sticker={sticker} data-empty={text ? undefined : ''}>
            {text}
          </span>
        ))
      }
      <span class:list={[styles.notches, 'workshop-only']} data-attention={progress.attention ?? undefined}>
        {PIPELINE_STEPS.map((_, i) => <span class={styles.notch} data-state={stepState(doc.status, i)} />)}
      </span>
    </span>
    <span class={styles.readEdge} aria-hidden="true"></span>
    <span class={styles.flatMeta} aria-hidden="true">
      {[doc.authors.join(', '), facts, read].filter(Boolean).join('; ')}
    </span>
  </a>
</li>
