---
/**
 * The library at a glance: pages read out of pages on the shelf, then one bar per book
 * on a common scale (bar length is the book's length, the inked part what you read), so
 * both how big each book is and how far into it you are read at once.
 */
import { plural } from '../library/spine';
import type { PagesChart } from './desk';

interface Props {
  chart: PagesChart;
}

const { chart } = Astro.props;
const pct = (n: number) => `${(n * 100).toFixed(2)}%`;
---

{
  chart.bars.length > 0 && (
    <section class="pages" aria-labelledby="pages-title">
      <h2 id="pages-title" class="section-title">Pages read</h2>
      <p class="total">
        <span class="big">{chart.read.toLocaleString('en')}</span>
        <span class="of">of {plural(chart.total, 'page')} on your shelf</span>
      </p>
      <ul class="bars">
        {chart.bars.map((bar) => (
          <li class="bar" title={`${bar.title}: ${bar.read} of ${bar.pages} pages read`}>
            <span class="bar-head">
              <span class="book-title bar-name">{bar.title}</span>
              <span class="bar-value">
                {bar.read}
                <span class="visually-hidden"> of {bar.pages} pages read</span>
                <span aria-hidden="true"> / {bar.pages}</span>
              </span>
            </span>
            <span class="track" style={`inline-size: ${pct(bar.width)}`} aria-hidden="true">
              <span class="fill" style={`inline-size: ${pct(bar.share)}`} />
            </span>
          </li>
        ))}
      </ul>
    </section>
  )
}

<style>
  .pages {
    display: grid;
    gap: var(--space-3);
  }

  .section-title {
    font-size: var(--text-md);
  }

  .total {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: var(--space-2);
    font-family: var(--font-ui);
    font-variant-numeric: tabular-nums;
  }

  .big {
    color: var(--ink);
    font-size: var(--text-xl);
    font-weight: 650;
    line-height: 1;
    letter-spacing: -0.02em;
  }

  .of {
    color: var(--ink-3);
    font-size: var(--text-sm);
  }

  .bars {
    display: grid;
    gap: var(--space-3);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .bar {
    display: grid;
    gap: var(--space-1);
  }

  .bar-head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--space-3);
    min-inline-size: 0;
  }

  .bar-name {
    overflow: hidden;
    color: var(--ink-2);
    font-size: var(--text-sm);
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .bar-value {
    flex: none;
    color: var(--ink-2);
    font-family: var(--font-ui);
    font-size: var(--text-xs);
    font-variant-numeric: tabular-nums;
  }

  .track {
    display: block;
    min-inline-size: 4px;
    block-size: 8px;
    overflow: hidden;
    border-radius: 0 4px 4px 0;
    background: var(--chart-grid);
    box-shadow: inset 0 0 0 1px var(--chart-axis);
  }

  .fill {
    display: block;
    block-size: 100%;
    border-radius: 0 4px 4px 0;
    background: var(--series-1);
  }
</style>
