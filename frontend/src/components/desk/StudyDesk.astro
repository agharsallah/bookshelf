---
/**
 * Study material across the library, grouped by book: what to read (brief, guide,
 * glossary, quotes) as sheets of paper, what to practise with (flashcards, quiz, FAQ)
 * as plain tiles, each naming what it lets you do. Only material that exists shows.
 */
import { splitMaterials, type StudyGroup } from './desk';

interface Props {
  groups: StudyGroup[];
}

const { groups } = Astro.props;
---

<section class="study" aria-labelledby="study-title">
  <h2 id="study-title" class="section-title">Study</h2>
  {
    groups.length === 0 ? (
      <p class="none">
        Nothing to study yet. Once a book is distilled, its brief, guide and flashcards appear here.
      </p>
    ) : (
      <div class="groups">
        {groups.map(({ book, materials }) => {
          const { read, practise } = splitMaterials(materials);
          return (
            <section class="group" aria-label={book.doc.title}>
              <h3 class="book-title group-title">
                <a href={`/documents/${book.doc.slug}`}>{book.doc.title}</a>
              </h3>
              <div class="tiles">
                {read.map((m) => (
                  <a class="tile sheet" href={m.href}>
                    <span class="tile-name">
                      {m.label}
                      {m.standing !== 'approved' && <span class="draft">draft</span>}
                    </span>
                    <span class="tile-hint">{m.hint}</span>
                  </a>
                ))}
                {practise.map((m) => (
                  <a class="tile practice" href={m.href}>
                    <span class="tile-name">
                      {m.label}
                      {m.standing !== 'approved' && <span class="draft">draft</span>}
                    </span>
                    <span class="tile-hint">{m.hint}</span>
                  </a>
                ))}
              </div>
            </section>
          );
        })}
      </div>
    )
  }
</section>

<style>
  .study {
    display: grid;
    gap: var(--space-4);
  }

  .section-title {
    font-size: var(--text-lg);
  }

  .none {
    color: var(--ink-2);
    font-family: var(--font-ui);
  }

  .groups {
    display: grid;
    gap: var(--space-6);
  }

  .group {
    display: grid;
    grid-template-columns: minmax(0, 16rem) minmax(0, 1fr);
    gap: var(--space-3) var(--space-6);
    align-items: start;
  }

  .group-title {
    font-size: var(--text-md);
    line-height: 1.2;
    overflow-wrap: anywhere;
  }

  .group-title a {
    color: var(--ink);
    text-decoration: none;
  }

  .group-title a:hover {
    color: var(--accent);
  }

  .tiles {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(11rem, 1fr));
    gap: var(--space-3);
  }

  .tile {
    display: grid;
    align-content: start;
    gap: var(--space-1);
    padding: var(--space-3) var(--space-4);
    color: var(--ink);
    text-decoration: none;
    transition:
      border-color var(--dur-1) var(--ease-out),
      translate var(--dur-2) var(--ease-turn);
  }

  /* What you read is the book's own content: a sheet on the desk. */
  .sheet {
    min-block-size: 5.5rem;
    border: 1px solid var(--rule);
    border-radius: var(--radius-l);
    background: var(--paper-raised);
    box-shadow: var(--shadow-lift);
  }

  .practice {
    border: 1px solid var(--rule-strong);
    border-radius: var(--radius-m);
  }

  .tile:hover {
    border-color: var(--accent);
    translate: 0 -2px;
  }

  .tile:hover .tile-name {
    color: var(--accent);
  }

  .tile-name {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-2);
    font-family: var(--font-ui);
    font-size: var(--text-ui);
    font-weight: 650;
  }

  .sheet .tile-name {
    font-family: var(--font-read);
    font-size: var(--text-md);
    font-weight: 560;
  }

  .tile-hint {
    color: var(--ink-3);
    font-family: var(--font-ui);
    font-size: var(--text-sm);
    line-height: var(--leading-ui);
  }

  .draft {
    padding: 0 var(--space-2);
    border: 1px dashed var(--tone-caution);
    border-radius: var(--radius-pill);
    color: var(--tone-caution);
    font-family: var(--font-ui);
    font-size: var(--text-xs);
    font-weight: 500;
  }

  @media (max-width: 56rem) {
    .group {
      grid-template-columns: minmax(0, 1fr);
    }
  }

  @media (max-width: 40rem) {
    .tiles {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
</style>
