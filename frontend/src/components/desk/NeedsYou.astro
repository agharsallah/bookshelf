---
/**
 * Workshop only: what is waiting for you — drafts to review, failed jobs to look at,
 * jobs still in progress — each linking to where you deal with it. Hidden in reading
 * mode; says so when nothing waits, and leaves the counts out when they cannot load.
 */
import type { NavCounts } from '../shell/nav';

interface Props {
  counts: NavCounts | null;
}

const { counts } = Astro.props;
const items = counts
  ? [
      { n: counts.review, one: 'draft to review', many: 'drafts to review', href: '/review', tone: 'caution' },
      { n: counts.failed, one: 'failed job', many: 'failed jobs', href: '/pipeline', tone: 'important' },
      { n: counts.active, one: 'job in progress', many: 'jobs in progress', href: '/pipeline', tone: 'quiet' },
    ].filter((item) => item.n > 0)
  : [];
---

<section class="needs workshop-only" aria-labelledby="needs-title">
  <h2 id="needs-title" class="section-title">Needs you</h2>
  {
    !counts ? (
      <p class="quiet">The review and pipeline counts could not be loaded. Open <a href="/review">Review</a> or <a href="/pipeline">Pipeline</a> to check.</p>
    ) : items.length === 0 ? (
      <p class="quiet">Nothing waits for review and no job has failed.</p>
    ) : (
      <ul class="items">
        {items.map((item) => (
          <li>
            <a href={item.href} data-tone={item.tone}>
              <span class="n">{item.n}</span>
              <span>{item.n === 1 ? item.one : item.many}</span>
            </a>
          </li>
        ))}
      </ul>
    )
  }
</section>

<style>
  .needs {
    display: grid;
    gap: var(--space-3);
    padding: var(--space-4);
    border: 1px dashed var(--rule-strong);
    border-radius: var(--radius-m);
  }

  .section-title {
    font-size: var(--text-md);
  }

  .quiet {
    color: var(--ink-3);
    font-family: var(--font-ui);
    font-size: var(--text-sm);
  }

  .items {
    display: grid;
    gap: var(--space-2);
    margin: 0;
    padding: 0;
    list-style: none;
    font-family: var(--font-ui);
    font-size: var(--text-ui);
  }

  a {
    display: flex;
    align-items: baseline;
    gap: var(--space-3);
    color: var(--ink);
    text-decoration: none;
  }

  a:hover span:last-child {
    color: var(--accent);
    text-decoration: underline;
  }

  .n {
    min-inline-size: 2.5ch;
    font-size: var(--text-md);
    font-weight: 650;
    font-variant-numeric: tabular-nums;
    text-align: end;
  }

  [data-tone='caution'] .n {
    color: var(--tone-caution);
  }

  [data-tone='important'] .n {
    color: var(--tone-important);
  }

  [data-tone='quiet'] .n {
    color: var(--ink-3);
  }
</style>
