---
/**
 * A book's study material as a compact row of links (Brief, Book guide, Flashcards…),
 * unapproved versions badged as drafts. Renders nothing when the book has none.
 */
import type { AvailableMaterial } from '../../lib/documents/study';

interface Props {
  materials: AvailableMaterial[];
  label: string;
}

const { materials, label } = Astro.props;
---

{
  materials.length > 0 && (
    <ul class="links" aria-label={label}>
      {materials.map((m) => (
        <li>
          <a href={m.href} title={m.hint}>
            {m.label}
            {m.standing !== 'approved' && <span class="draft">draft</span>}
          </a>
        </li>
      ))}
    </ul>
  )
}

<style>
  .links {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    margin: 0;
    padding: 0;
    list-style: none;
    font-family: var(--font-ui);
    font-size: var(--text-sm);
  }

  a {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    min-block-size: 2.25rem;
    padding: 0 var(--space-3);
    border: 1px solid var(--rule-strong);
    border-radius: var(--radius-m);
    color: var(--ink);
    font-weight: 600;
    text-decoration: none;
    transition:
      border-color var(--dur-1) var(--ease-out),
      color var(--dur-1) var(--ease-out);
  }

  a:hover {
    border-color: var(--accent);
    color: var(--accent);
  }

  .draft {
    padding: 0 var(--space-2);
    border: 1px dashed var(--tone-caution);
    border-radius: var(--radius-pill);
    color: var(--tone-caution);
    font-size: var(--text-xs);
    font-weight: 500;
  }
</style>
