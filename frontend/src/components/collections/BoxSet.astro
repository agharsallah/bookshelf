---
/**
 * A collection drawn as a box set: its members stand in a slipcase in reading order, one
 * spine each. A spine's height and width say what it is (a book stands tall, a paper
 * slimmer, an article is a thin pamphlet), its cloth wears the genre's dye, and the
 * highlighter rises up it as it is read. The member up next stands pulled half out.
 * Decorative: the page states the same facts in words.
 */
import type { Genre } from '../../lib/api/types/documents';

export interface BoxSetMember {
  id: string;
  title: string;
  genre: Genre;
  /** 0–1 read, a finished mark counting as read through. */
  share: number;
}

interface Props {
  members: BoxSetMember[];
  /** The id of the member up next, pulled half out. */
  next?: string | null;
  size?: 'small' | 'large';
  /** Spines shown before the rest fold into a "+n" block. */
  limit?: number;
  /** Show only in one cheer tone (base.css), e.g. where the playful board stands in for it. */
  cheerOnly?: 'quiet' | 'playful';
}

const { members, next = null, size = 'small', limit = 12, cheerOnly } = Astro.props;
const shown = members.slice(0, limit);
const more = members.length - shown.length;
/** A steady width per title, so a set looks the same on every visit. */
const girth = (title: string) => [...title].reduce((sum, ch) => sum + ch.charCodeAt(0), 0) % 3;
---

<div class="box" data-size={size} data-cheer-only={cheerOnly} aria-hidden="true">
  {
    shown.length === 0 ? (
      <span class="empty" />
    ) : (
      shown.map((m) => (
        <span
          class="spine"
          data-genre={m.genre}
          data-girth={girth(m.title)}
          data-next={m.id === next ? '' : undefined}
          style={`--share:${Math.min(Math.max(m.share, 0), 1)}`}
        />
      ))
    )
  }
  {more > 0 && <span class="more">+{more}</span>}
</div>

<style>
  .box {
    --unit: 0.5rem;
    --tall: 5.5rem;
    display: flex;
    align-items: flex-end;
    gap: 2px;
    min-inline-size: 6rem;
    max-inline-size: 100%;
    overflow: hidden;
    block-size: calc(var(--tall) + var(--space-3));
    padding: var(--space-3) var(--space-2) 0;
    border: 1px solid var(--rule-strong);
    border-block-start: 0;
    border-block-end-width: 4px;
    border-radius: 0 0 var(--radius-s) var(--radius-s);
    background: linear-gradient(to top, var(--paper-sunken), transparent 85%);
  }

  .box[data-size='large'] {
    --unit: 0.75rem;
    --tall: 9rem;
    gap: 3px;
    inline-size: 22rem;
    padding-inline: var(--space-3);
  }

  .spine {
    --genre: var(--accent);
    --girth: 2.4;
    position: relative;
    /* A crowded set packs tighter: spines give up width, never height. */
    flex: 0 1 calc(var(--unit) * var(--girth));
    min-inline-size: 3px;
    block-size: var(--tall);
    border-radius: 2px 2px 0 0;
    background:
      linear-gradient(90deg, rgb(0 0 0 / 0.22), transparent 25%, rgb(255 255 255 / 0.1) 50%, transparent 75%, rgb(0 0 0 / 0.24)),
      var(--genre);
    overflow: hidden;
  }

  .spine[data-girth='1'] {
    --girth: 2;
  }

  .spine[data-girth='2'] {
    --girth: 2.9;
  }

  .spine[data-genre='paper'] {
    --genre: var(--tone-question);
    --girth: 1.5;
    block-size: calc(var(--tall) * 0.8);
  }

  .spine[data-genre='article'] {
    --genre: var(--tone-antipattern);
    --girth: 0.9;
    block-size: calc(var(--tall) * 0.62);
    border-radius: 1px;
  }

  /* A band near the head, the way cloth spines carry their gilt rule. */
  .spine::before {
    content: '';
    position: absolute;
    inset-inline: 0;
    inset-block-start: 14%;
    block-size: 2px;
    background: rgb(255 255 255 / 0.35);
  }

  /* The highlighter rising as it is read. */
  .spine::after {
    content: '';
    position: absolute;
    inset-inline-end: 0;
    inset-block-end: 0;
    inline-size: 3px;
    block-size: calc(var(--share) * 100%);
    background: var(--marker);
  }

  .spine[data-next] {
    translate: 0 calc(var(--space-3) * -1);
    box-shadow: 0 -3px 0 var(--marker);
  }

  .more {
    flex: none;
    align-self: center;
    padding-inline: var(--space-1);
    color: var(--ink-3);
    font-family: var(--font-ui);
    font-size: var(--text-xs);
    font-weight: 700;
    font-variant-numeric: tabular-nums;
  }

  .empty {
    flex: 1;
    block-size: 40%;
    border: 1px dashed var(--rule-strong);
    border-block-end: 0;
    border-radius: 2px 2px 0 0;
  }
</style>
