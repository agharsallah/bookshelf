---
/**
 * The book guide as one long, visual page: at a glance first (size, the whole argument,
 * the numbers to remember, the big-picture map, the chapter journey, the themes), then
 * the core ideas at depth and the book as a playbook. The header is static; the
 * sections are one island (GuideBody) so cites open their passage in place and
 * drawings can be magnified.
 */
import type { PreparedBlock } from '../../lib/prepare';
import GuideBody from './GuideBody';
import NumberTiles from './NumberTiles';
import type { ChapterRow, Glance, GuideSection, KeyNumber, Theme } from './guide';
import type { PassageUnit } from './passage';

interface Props {
  slug: string;
  title: string;
  authors: string[];
  year: number | null;
  sections: (GuideSection & { blocks: PreparedBlock[] })[];
  rows: ChapterRow[];
  themes: Theme[];
  numbers: KeyNumber[];
  units: PassageUnit[];
  glance: Glance[];
  approvedOn: string | null;
  version: number;
  draft: boolean;
  hasBrief: boolean;
}

const { slug, title, authors, year, sections, rows, themes, numbers, units, glance, approvedOn, version, draft, hasBrief } = Astro.props;
const byKey = new Map(sections.map((s) => [s.key, s]));
const overview = byKey.get('overview');
const map = byKey.get('map');
const deep = byKey.get('deep_dive');
const practice = byKey.get('practice');

const nav = [
  overview && { id: 'guide-overview', label: overview.title },
  numbers.length > 0 && { id: 'guide-numbers', label: 'Numbers' },
  map && { id: 'guide-map', label: map.title },
  rows.length > 0 && { id: 'guide-journey', label: 'Chapter by chapter' },
  themes.length > 0 && { id: 'guide-themes', label: 'Themes' },
  deep && { id: 'guide-deep', label: deep.title },
  practice && { id: 'guide-practice', label: practice.title },
].filter((item): item is { id: string; label: string } => Boolean(item));
---

<article class="sheet" aria-labelledby="guide-title">
  <header class="head">
    <p class="kind">Book guide{draft && <span class="draft">Draft, waiting for review</span>}</p>
    <h1 id="guide-title">{title}</h1>
    <p class="byline">
      {authors.join(', ')}{year ? `, ${year}` : ''}
    </p>
    <p class="stamp workshop-only">
      Version {version}{approvedOn ? `, approved ${approvedOn}` : ''}
    </p>
    {
      glance.length > 0 && (
        <div class="glance">
          <NumberTiles tiles={glance} variant="quiet" label="At a glance" />
        </div>
      )
    }
  </header>

  <nav class="toc" aria-label="On this page">
    <ul>
      {
        nav.map((item) => (
          <li>
            <a href={`#${item.id}`}>{item.label}</a>
          </li>
        ))
      }
    </ul>
  </nav>

  <GuideBody client:load slug={slug} sections={sections} rows={rows} themes={themes} numbers={numbers} units={units} />

  <footer class="foot">
    {hasBrief && <a href={`/documents/${slug}/brief`}>Read the one-page brief</a>}
    <a href={`/documents/${slug}`}>Back to the document</a>
  </footer>
</article>

<style>
  .sheet {
    --sheet-pad: clamp(1rem, 4vw, 3.5rem);
    display: grid;
    grid-template-columns: minmax(0, 1fr); /* wide diagrams and tables scroll, never the page */
    gap: var(--space-7);
    max-width: 68rem;
    margin-inline: auto;
    padding: var(--sheet-pad);
    border: 1px solid var(--rule);
    border-radius: var(--radius-l);
    background: var(--paper-raised);
    box-shadow: var(--shadow-lift);
  }

  .head {
    display: grid;
    grid-template-columns: 1fr auto;
    gap: var(--space-1) var(--space-5);
    padding-block-end: var(--space-5);
    border-block-end: 2px solid var(--ink);
  }

  .kind {
    grid-column: 1 / -1;
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
    align-items: baseline;
    color: var(--accent);
    font-family: var(--font-ui);
    font-size: var(--text-sm);
    font-weight: 600;
  }

  .draft {
    padding: 0 var(--space-2);
    border: 1px solid var(--tone-caution);
    border-radius: var(--radius-m);
    color: var(--tone-caution);
    font-weight: 500;
  }

  h1,
  h2 {
    font-family: var(--font-read);
  }

  h1 {
    grid-column: 1 / -1;
    font-size: clamp(2rem, 4.5vw, 3.25rem);
    font-weight: 450;
    letter-spacing: -0.02em;
  }

  .byline {
    color: var(--ink-2);
    font-style: italic;
  }

  .stamp {
    align-self: end;
    color: var(--ink-3);
    font-family: var(--font-ui);
    font-size: var(--text-xs);
    text-align: end;
  }

  .glance {
    grid-column: 1 / -1;
    margin-block-start: var(--space-4);
  }

  .toc {
    position: sticky;
    top: 0;
    z-index: 2;
    margin-block: calc(-1 * var(--space-5));
    padding-block: var(--space-2);
    background: var(--paper-raised);
    border-block-end: 1px solid var(--rule);
  }

  .toc ul {
    display: flex;
    gap: var(--space-1) var(--space-4);
    margin: 0;
    padding: 0;
    overflow-x: auto;
    font-family: var(--font-ui);
    font-size: var(--text-sm);
    list-style: none;
    scrollbar-width: none;
  }

  .toc a {
    display: block;
    padding-block: var(--space-1);
    color: var(--ink-2);
    white-space: nowrap;
    text-decoration: none;
  }

  .toc a:hover {
    color: var(--accent);
  }

  .foot {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-5);
    padding-block-start: var(--space-4);
    border-block-start: 1px solid var(--rule);
    font-family: var(--font-ui);
    font-size: var(--text-sm);
  }

  .foot a {
    color: var(--ink-3);
  }

  @media (max-width: 48rem) {
    .head {
      grid-template-columns: 1fr;
    }

    .stamp {
      text-align: start;
    }

    .sheet {
      gap: var(--space-6);
    }
  }

  @media print {
    .sheet {
      max-width: none;
      padding: 0;
      border: 0;
      box-shadow: none;
      background: none;
      font-size: 10pt;
    }

    .toc,
    .foot {
      display: none;
    }

    .sheet :global(a) {
      color: inherit;
      text-decoration: none;
    }
  }
</style>
