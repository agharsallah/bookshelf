---
/**
 * What Today shows while its server island (Today.astro) loads: the day's line and the
 * two columns as quiet shimmering blocks in the same layout, so nothing jumps when the
 * real content replaces them. The blocks are hidden from assistive tech; a status says
 * the page is loading.
 */
---

<div class="placeholder" role="status">
  <span class="visually-hidden">Loading your day</span>
  <span class="block plan" aria-hidden="true"></span>
  <div class="columns" aria-hidden="true">
    <div class="main">
      <span class="block card"></span>
      <span class="block sheet"></span>
    </div>
    <div class="side">
      <span class="block pickup"></span>
      <span class="block short"></span>
    </div>
  </div>
</div>

<style>
  .placeholder {
    display: grid;
    gap: var(--space-6);
  }

  .columns {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 22rem;
    gap: var(--space-7);
    align-items: start;
  }

  .main,
  .side {
    display: grid;
    gap: var(--space-5);
  }

  .block {
    display: block;
    border-radius: var(--radius-m);
    background: linear-gradient(90deg, var(--paper-sunken), var(--paper-raised), var(--paper-sunken));
    background-size: 200% 100%;
    animation: shimmer 1.4s linear infinite;
  }

  .plan {
    inline-size: min(36rem, 90%);
    block-size: 1.75rem;
  }

  .card {
    block-size: 18rem;
  }

  .sheet {
    block-size: 12rem;
  }

  .pickup {
    block-size: 16rem;
  }

  .short {
    block-size: 7rem;
  }

  @keyframes shimmer {
    to {
      background-position: -200% 0;
    }
  }

  @media (max-width: 60rem) {
    .columns {
      grid-template-columns: minmax(0, 1fr);
      gap: var(--space-6);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .block {
      animation: none;
    }
  }
</style>
