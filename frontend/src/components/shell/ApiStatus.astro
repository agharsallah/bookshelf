---
/**
 * Footer indicator for the backend: up, degraded (Qdrant unreachable, so only
 * meaning-based search is off) or down. Checked from the browser through the /api
 * proxy (`/health` + `/health/ready`), so static pages stay static and the result
 * reflects the reader's connection. The reason sits in the tooltip.
 */
---

<p class="api-status" data-api-status="checking" role="status">
  <span class="dot" aria-hidden="true"></span>
  <span data-api-status-text>Checking the API…</span>
</p>

<script>
  import { browserApi, type Health, type Readiness } from '../../lib/api';
  import { describeHealth } from '../../lib/api/health';

  const el = document.querySelector<HTMLElement>('[data-api-status]');
  const text = el?.querySelector<HTMLElement>('[data-api-status-text]');
  const settle = <T,>(request: Promise<T>) => request.catch((error: unknown) => error);
  if (el && text) {
    Promise.all([settle(browserApi.get<Health>('health')), settle(browserApi.get<Readiness>('health/ready'))]).then(([health, ready]) => {
      const { state, message, detail } = describeHealth(health, ready);
      el.dataset.apiStatus = state;
      text.textContent = message;
      if (detail) el.title = detail;
    });
  }
</script>

<style>
  .api-status {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    font-family: var(--font-ui);
    font-size: var(--text-xs);
    color: var(--ink-3);
  }

  .dot {
    width: 0.5rem;
    height: 0.5rem;
    border-radius: 50%;
    background: var(--rule-strong);
  }

  [data-api-status='up'] .dot {
    background: var(--tone-insight);
  }

  [data-api-status='degraded'] .dot {
    background: var(--tone-caution);
  }

  [data-api-status='down'] .dot {
    background: transparent;
    border: 1.5px solid var(--tone-important);
  }
</style>
