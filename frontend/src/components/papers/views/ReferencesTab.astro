---
/**
 * References tab: the paper's bibliography in order, each entry with why it is cited
 * (its intent, once classified), where the paper cites it (links into the reader), and
 * what it is to you: on the shelf, in the reading queue (with the action to queue it),
 * or neither. Filters (`?intent=`, `?shelf=1`) are links, so the page works without JS.
 */
import { Problem } from '../../common/Problem';
import { anchorLabel } from '../../../lib/anchors';
import { serverApi } from '../../../lib/api/server';
import { load } from '../../../lib/documents/server';
import { listReferences } from '../../../lib/papers/api';
import CandidateAction from '../CandidateAction';
import { authorLine, INTENT_LABELS } from '../labels';
import { intentCounts, parseReferenceFilters, referencesHref, referencesQuery, referenceStanding, referenceTitle } from '../references';
import TabEmpty from '../TabEmpty.astro';
import type { TabViewProps } from '../tabs';

type Props = TabViewProps;

/** In-text citations shown per entry before "and n more". */
const CITED_AT_SHOWN = 4;

const { paper, url } = Astro.props;
const filters = parseReferenceFilters(url.searchParams);
const filtered = filters.intent !== null || filters.onShelf;
const loaded = await load(async () => {
  const [rows, all] = await Promise.all([
    listReferences(serverApi(), paper.slug, referencesQuery(filters)),
    filters.intent ? listReferences(serverApi(), paper.slug) : Promise.resolve(null),
  ]);
  return { rows, intents: intentCounts(all ?? rows) };
});
const data = loaded.ok ? loaded.value : null;
const readHref = (anchor: string) => `/documents/${paper.slug}/read/${anchor}`;
const summary = `${paper.counts.references} ${paper.counts.references === 1 ? 'entry' : 'entries'}, ${paper.counts.references_on_shelf} on your shelf`;
---

{
  !data ? (
    !loaded.ok && <Problem title="The references could not be loaded." problem={loaded.problem} />
  ) : data.rows.length === 0 && !filtered ? (
    <TabEmpty
      title="No bibliography found"
      body="The references are read from the paper's References section after parsing. None were found: the section may be missing, or its heading was not recognised. Fixing the outline on the document page and re-running the structure step finds them again."
    />
  ) : (
    <div class="refs">
      <div class="bar">
        <p class="summary">{summary}</p>
        <nav class="filters" aria-label="Filter references">
          <a href={referencesHref(paper.slug, { intent: null, onShelf: false })} aria-current={!filtered ? 'true' : undefined}>
            All
          </a>
          <a href={referencesHref(paper.slug, { ...filters, onShelf: !filters.onShelf })} aria-current={filters.onShelf ? 'true' : undefined}>
            On your shelf
          </a>
          {data.intents.map(({ intent, count }) => (
            <a
              href={referencesHref(paper.slug, { ...filters, intent: filters.intent === intent ? null : intent })}
              aria-current={filters.intent === intent ? 'true' : undefined}
            >
              {INTENT_LABELS[intent]} <span class="count">{count}</span>
            </a>
          ))}
        </nav>
      </div>

      {data.rows.length === 0 ? (
        <p class="none">No entries match. <a href={referencesHref(paper.slug, { intent: null, onShelf: false })}>Show them all</a></p>
      ) : (
        <ol class="list">
          {data.rows.map((row) => {
            const standing = referenceStanding(row);
            const shown = row.cited_at.slice(0, CITED_AT_SHOWN);
            const more = row.cited_at.length - shown.length;
            return (
              <li class="entry" id={`ref-${row.ordinal}`}>
                <span class="ordinal">[{row.ordinal}]</span>
                <div class="what">
                  <p class="title">{referenceTitle(row)}</p>
                  <p class="meta">{[authorLine(row.authors), row.venue, row.year].filter(Boolean).join(', ')}</p>
                  {shown.length > 0 && (
                    <p class="cited">
                      Cited at{' '}
                      {shown.map((anchor, i) => (
                        <>
                          {i > 0 && ', '}
                          <a href={readHref(anchor)} title={anchor}>
                            {anchorLabel(anchor)}
                          </a>
                        </>
                      ))}
                      {more > 0 && ` and ${more} more`}
                    </p>
                  )}
                </div>
                <div class="side">
                  {row.intent && (
                    <span class="intent" data-intent={row.intent}>
                      {INTENT_LABELS[row.intent]}
                    </span>
                  )}
                  {standing.kind === 'shelf' ? (
                    <a class="shelf" href={standing.href}>
                      On your shelf
                    </a>
                  ) : standing.kind === 'candidate' ? (
                    <CandidateAction client:visible id={standing.id} status={standing.status} />
                  ) : (
                    <span class="nothing">Not on your shelf</span>
                  )}
                </div>
              </li>
            );
          })}
        </ol>
      )}
    </div>
  )
}

<style>
  .refs {
    display: grid;
    gap: var(--space-4);
    max-width: 68rem;
    margin-inline: auto;
  }

  .bar {
    display: grid;
    gap: var(--space-2);
  }

  .summary,
  .none {
    color: var(--ink-2);
    font-family: var(--font-ui);
    font-size: var(--text-sm);
  }

  .filters {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    font-family: var(--font-ui);
    font-size: var(--text-sm);
  }

  .filters a {
    padding: var(--space-1) var(--space-3);
    border: 1px solid var(--rule);
    border-radius: var(--radius-pill);
    color: var(--ink-2);
    text-decoration: none;
  }

  .filters a:hover {
    border-color: var(--rule-strong);
    color: var(--ink);
  }

  .filters a[aria-current='true'] {
    border-color: var(--accent);
    background: var(--accent-wash);
    color: var(--ink);
  }

  .count {
    color: var(--ink-3);
    font-size: var(--text-xs);
    font-variant-numeric: tabular-nums;
  }

  .list {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .entry {
    display: grid;
    grid-template-columns: 3rem minmax(0, 1fr) minmax(10rem, 14rem);
    gap: var(--space-1) var(--space-4);
    padding-block: var(--space-3);
    border-block-start: 1px solid var(--rule);
    scroll-margin-block-start: 4rem;
  }

  .entry:target {
    background: var(--accent-wash);
  }

  .ordinal {
    color: var(--ink-3);
    font-family: var(--font-ui);
    font-size: var(--text-sm);
    font-variant-numeric: tabular-nums;
    text-align: end;
  }

  .what {
    display: grid;
    gap: var(--space-1);
    min-inline-size: 0;
  }

  .title {
    font-family: var(--font-read);
    line-height: 1.35;
    overflow-wrap: anywhere;
  }

  .meta,
  .cited {
    color: var(--ink-3);
    font-family: var(--font-ui);
    font-size: var(--text-sm);
  }

  .cited a {
    color: var(--ink-2);
    font-variant-numeric: tabular-nums;
  }

  .side {
    display: grid;
    gap: var(--space-1);
    align-content: start;
    justify-items: start;
    font-family: var(--font-ui);
    font-size: var(--text-sm);
  }

  .intent {
    padding: 0 var(--space-2);
    border: 1px solid var(--rule-strong);
    border-radius: var(--radius-pill);
    color: var(--ink-2);
    font-size: var(--text-xs);
  }

  .intent[data-intent='extends'],
  .intent[data-intent='uses'] {
    border-color: var(--accent);
    color: var(--accent);
  }

  .intent[data-intent='contradicts'] {
    border-color: var(--tone-important);
    color: var(--tone-important);
  }

  .shelf {
    color: var(--accent);
    font-weight: 600;
  }

  .nothing {
    color: var(--ink-3);
  }

  @media (max-width: 44rem) {
    .entry {
      grid-template-columns: 2.5rem minmax(0, 1fr);
    }

    .side {
      grid-column: 2;
    }
  }
</style>
