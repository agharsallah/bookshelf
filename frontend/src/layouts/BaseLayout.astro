---
/**
 * App shell: head (fonts, theme bootstrap), skip link, masthead with primary nav,
 * a `actions` slot for page-level controls, main content, footer with API status.
 */
import { Font } from 'astro:assets';
import { PUBLIC_APP_NAME } from 'astro:env/client';
import '../styles/base.css';
import ApiStatus from '../components/shell/ApiStatus.astro';
import ThemeToggle from '../components/shell/ThemeToggle.astro';
import CommandPalette from '../components/search/CommandPalette';
import { themeBootstrapScript } from '../lib/theme';

interface Props {
  title?: string;
  description?: string;
  /** `reading` keeps a book measure; `wide` suits grids, graphs and two-pane readers. */
  width?: 'reading' | 'wide';
}

const { title, description = 'Books and articles, distilled and cited.', width = 'wide' } = Astro.props;
const pageTitle = title ? `${title} — ${PUBLIC_APP_NAME}` : PUBLIC_APP_NAME;

const NAV = [
  { href: '/library', label: 'Library' },
  { href: '/search', label: 'Search' },
  { href: '/graph', label: 'Graph' },
  { href: '/review', label: 'Review' },
  { href: '/pipeline', label: 'Pipeline' },
];
const path = Astro.url.pathname;
const isCurrent = (href: string) => path === href || path.startsWith(`${href}/`);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <script is:inline set:html={themeBootstrapScript} />
    <meta name="color-scheme" content="light dark" />
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <Font cssVariable="--font-literata" preload />
    <Font cssVariable="--font-schibsted" />
    <Font cssVariable="--font-plex-mono" />
    <title>{pageTitle}</title>
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>

    <header class="masthead">
      <div class="masthead-inner">
        <a class="wordmark" href="/">{PUBLIC_APP_NAME}</a>
        <nav class="primary-nav" aria-label="Primary">
          <ul>
            {
              NAV.map((item) => (
                <li>
                  <a href={item.href} aria-current={isCurrent(item.href) ? 'page' : undefined}>
                    {item.label}
                  </a>
                </li>
              ))
            }
          </ul>
        </nav>
        <div class="actions">
          <slot name="actions" />
          <CommandPalette client:idle />
          <ThemeToggle />
        </div>
      </div>
    </header>

    <main id="main" class:list={['main', `main--${width}`]} tabindex="-1">
      <slot />
    </main>

    <footer class="colophon">
      <div class="colophon-inner">
        <ApiStatus />
        <a href="/styleguide">Styleguide</a>
      </div>
    </footer>

    <script>
      import { enhanceStaticDiagrams } from '../lib/mermaid';
      import { followSystemTheme } from '../lib/theme';

      followSystemTheme();
      enhanceStaticDiagrams();
    </script>
  </body>
</html>

<style>
  body {
    display: grid;
    grid-template-rows: auto 1fr auto;
  }

  .skip-link {
    position: absolute;
    inset-inline-start: var(--space-4);
    inset-block-start: -4rem;
    z-index: 100;
    padding: var(--space-2) var(--space-4);
    border-radius: var(--radius-m);
    background: var(--ink);
    color: var(--paper);
    font-family: var(--font-ui);
    font-size: var(--text-ui);
  }

  .skip-link:focus {
    inset-block-start: var(--space-2);
  }

  .masthead {
    position: sticky;
    inset-block-start: 0;
    z-index: 20;
    border-block-end: 1px solid var(--rule);
    background: color-mix(in oklab, var(--paper) 92%, transparent);
    backdrop-filter: blur(8px);
  }

  .masthead-inner,
  .colophon-inner {
    display: flex;
    align-items: center;
    gap: var(--space-5);
    max-width: 78rem;
    margin-inline: auto;
    padding-inline: var(--space-5);
  }

  .masthead-inner {
    min-height: 3.5rem;
  }

  .wordmark {
    color: var(--ink);
    font-family: var(--font-read);
    font-size: var(--text-md);
    font-style: italic;
    font-weight: 500;
    letter-spacing: -0.01em;
    text-decoration: none;
  }

  .primary-nav ul {
    display: flex;
    gap: var(--space-1);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .primary-nav a {
    position: relative;
    display: block;
    padding: var(--space-2) var(--space-3);
    color: var(--ink-2);
    font-family: var(--font-ui);
    font-size: var(--text-ui);
    text-decoration: none;
    transition: color var(--dur-1) var(--ease-out);
  }

  .primary-nav a:hover {
    color: var(--ink);
  }

  .primary-nav a[aria-current='page'] {
    color: var(--ink);
    font-weight: 600;
  }

  /* The current section wears a ribbon bookmark hanging from the masthead's top edge. */
  .primary-nav a[aria-current='page']::before {
    content: '';
    position: absolute;
    inset-block-start: calc(-1 * (3.5rem - 2.25rem) / 2);
    inset-inline-start: 50%;
    width: 0.625rem;
    height: 1.1rem;
    translate: -50% 0;
    background: var(--accent);
    clip-path: polygon(0 0, 100% 0, 100% 100%, 50% 72%, 0 100%);
  }

  .actions {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    margin-inline-start: auto;
  }

  .main {
    width: 100%;
    margin-inline: auto;
    padding: var(--space-7) var(--space-5) var(--space-8);
  }

  .main:focus {
    outline: none;
  }

  .main--wide {
    max-width: 78rem;
  }

  .main--reading {
    max-width: calc(var(--measure) + 2 * var(--space-5));
  }

  .colophon {
    border-block-start: 1px solid var(--rule);
  }

  .colophon-inner {
    justify-content: space-between;
    min-height: 3rem;
    font-family: var(--font-ui);
    font-size: var(--text-xs);
  }

  .colophon-inner a {
    color: var(--ink-3);
  }

  @media (max-width: 40rem) {
    .masthead-inner {
      flex-wrap: wrap;
      gap: 0 var(--space-3);
      padding-inline: var(--space-4);
    }

    .primary-nav {
      order: 3;
      width: 100%;
      margin-inline: calc(-1 * var(--space-3));
    }

    .primary-nav a[aria-current='page']::before {
      display: none;
    }

    .primary-nav a[aria-current='page'] {
      text-decoration: underline 2px var(--accent);
      text-underline-offset: 0.4em;
    }

    .main {
      padding: var(--space-6) var(--space-4) var(--space-7);
    }

    .colophon-inner {
      padding-inline: var(--space-4);
    }
  }
</style>
