---
/**
 * App shell: head (fonts, theme and mode bootstraps), skip link, masthead with the
 * reading navigation and, in workshop mode, the review and pipeline pages with their
 * live counts; an `actions` slot for page-level controls, main content, footer.
 */
import { Font } from 'astro:assets';
import { PUBLIC_APP_NAME } from 'astro:env/client';
import '../styles/base.css';
import ApiStatus from '../components/shell/ApiStatus.astro';
import ThemeToggle from '../components/shell/ThemeToggle.astro';
import WorkshopToggle from '../components/shell/WorkshopToggle.astro';
import CommandPalette from '../components/search/CommandPalette';
import { NAV, isCurrent } from '../components/shell/nav';
import { themeBootstrapScript } from '../lib/theme';
import { workshopBootstrapScript } from '../lib/workshop';

interface Props {
  title?: string;
  description?: string;
  /** `reading` keeps a book measure; `wide` suits grids, graphs and two-pane readers. */
  width?: 'reading' | 'wide';
}

const { title, description = 'Books and articles, distilled and cited.', width = 'wide' } = Astro.props;
const pageTitle = title ? `${title} — ${PUBLIC_APP_NAME}` : PUBLIC_APP_NAME;
const path = Astro.url.pathname;
const reading = NAV.filter((item) => !item.workshop);
const workshop = NAV.filter((item) => item.workshop);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <script is:inline set:html={themeBootstrapScript} />
    <script is:inline set:html={workshopBootstrapScript} />
    <meta name="color-scheme" content="light dark" />
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <Font cssVariable="--font-source-serif" preload />
    <Font cssVariable="--font-hanken" preload />
    <Font cssVariable="--font-plex-mono" />
    <title>{pageTitle}</title>
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>

    <header class="masthead">
      <div class="masthead-inner">
        <a class="wordmark" href="/" aria-label={`${PUBLIC_APP_NAME}, your desk`}>
          <svg class="glyph" viewBox="0 0 24 24" width="22" height="22" aria-hidden="true">
            <rect x="3" y="5" width="4" height="15" rx="1" />
            <rect x="8.5" y="3" width="4" height="17" rx="1" class="glyph-marked" />
            <rect x="14" y="7" width="4" height="13" rx="1" transform="rotate(-12 16 13.5)" />
            <path d="M2 21h20" />
          </svg>
          <span>{PUBLIC_APP_NAME}</span>
        </a>
        <nav class="primary-nav" aria-label="Primary">
          <ul>
            {
              reading.map((item) => (
                <li>
                  <a href={item.href} aria-current={isCurrent(item, path) ? 'page' : undefined}>
                    <span class="nav-label">{item.label}</span>
                  </a>
                </li>
              ))
            }
            <li class="nav-divider workshop-only" aria-hidden="true"></li>
            {
              workshop.map((item) => (
                <li class="workshop-only">
                  <a href={item.href} aria-current={isCurrent(item, path) ? 'page' : undefined} data-nav-item={item.count}>
                    <span class="nav-label">{item.label}</span>
                    {item.count === 'review' ? <span class="nav-count" data-nav-count="review" hidden /> : null}
                    {item.count === 'pipeline' ? <span class="nav-signal" data-nav-signal="idle" hidden /> : null}
                  </a>
                </li>
              ))
            }
          </ul>
        </nav>
        <div class="actions">
          <slot name="actions" />
          <CommandPalette client:idle />
          <WorkshopToggle />
          <ThemeToggle />
        </div>
      </div>
    </header>

    <main id="main" class:list={['main', `main--${width}`]} tabindex="-1">
      <slot />
    </main>

    <footer class="colophon">
      <div class="colophon-inner">
        <ApiStatus />
        <a class="workshop-only" href="/styleguide">Styleguide</a>
      </div>
    </footer>

    <script>
      import { browserApi } from '../lib/api/client';
      import { enhanceStaticDiagrams } from '../lib/mermaid';
      import { followSystemTheme } from '../lib/theme';
      import { isWorkshop, WORKSHOP_CHANGE_EVENT } from '../lib/workshop';
      import { loadNavCounts, pipelineSignal } from '../components/shell/nav';

      followSystemTheme();
      enhanceStaticDiagrams();

      // The workshop links wear their counts; fetched only when they are shown.
      let counted = false;
      async function count() {
        if (counted || !isWorkshop()) return;
        counted = true;
        try {
          const counts = await loadNavCounts(browserApi);
          const review = document.querySelector<HTMLElement>('[data-nav-count="review"]');
          if (review && counts.review > 0) {
            review.textContent = String(counts.review);
            review.hidden = false;
            review.closest('a')?.setAttribute('aria-label', `Review, ${counts.review} waiting`);
          }
          const signal = document.querySelector<HTMLElement>('[data-nav-signal]');
          if (signal) {
            const { state, label } = pipelineSignal(counts);
            signal.dataset.navSignal = state;
            signal.hidden = state === 'idle';
            signal.closest('a')?.setAttribute('aria-label', `Pipeline, ${label.toLowerCase()}`);
            signal.closest('a')?.setAttribute('title', label);
          }
        } catch {
          counted = false; // offline or the API is down: the footer says so; try again on the next switch
        }
      }
      void count();
      window.addEventListener(WORKSHOP_CHANGE_EVENT, () => void count());
    </script>
  </body>
</html>

<style>
  body {
    display: grid;
    /* minmax(0, …): no child's min-content may widen the page past the viewport. */
    grid-template-columns: minmax(0, 1fr);
    grid-template-rows: auto 1fr auto;
  }

  .skip-link {
    position: absolute;
    inset-inline-start: var(--space-4);
    inset-block-start: -4rem;
    z-index: 100;
    padding: var(--space-2) var(--space-4);
    border-radius: var(--radius-m);
    background: var(--ink);
    color: var(--paper);
    font-family: var(--font-ui);
    font-size: var(--text-ui);
  }

  .skip-link:focus {
    inset-block-start: var(--space-2);
  }

  .masthead {
    position: sticky;
    inset-block-start: 0;
    z-index: 20;
    border-block-end: 1px solid var(--rule);
    background: color-mix(in oklab, var(--paper) 88%, transparent);
    backdrop-filter: blur(10px) saturate(1.2);
  }

  .masthead-inner,
  .colophon-inner {
    display: flex;
    align-items: center;
    gap: var(--space-5);
    max-width: 80rem;
    margin-inline: auto;
    padding-inline: var(--space-5);
  }

  .masthead-inner {
    min-height: 3.75rem;
  }

  .wordmark {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    color: var(--ink);
    font-family: var(--font-read);
    font-size: var(--text-md);
    font-weight: 650;
    letter-spacing: -0.02em;
    text-decoration: none;
  }

  .glyph {
    fill: none;
    stroke: currentColor;
    stroke-width: 1.6;
    stroke-linecap: round;
  }

  /* One spine is marked: the book you are in the middle of. */
  .glyph-marked {
    fill: var(--marker);
    stroke: var(--ink);
  }

  .primary-nav ul {
    display: flex;
    align-items: center;
    gap: var(--space-1);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .primary-nav a {
    position: relative;
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    padding: var(--space-2) var(--space-3);
    border-radius: var(--radius-m);
    color: var(--ink-2);
    font-family: var(--font-ui);
    font-size: var(--text-ui);
    font-weight: 550;
    text-decoration: none;
    transition: color var(--dur-1) var(--ease-out);
  }

  .primary-nav a:hover {
    color: var(--ink);
  }

  /* The highlighter stroke: previewed on hover, drawn in under the page you are on. */
  .nav-label {
    position: relative;
    z-index: 0;
  }

  .nav-label::before {
    content: '';
    position: absolute;
    inset: auto -0.2em 0.02em;
    z-index: -1;
    block-size: 0.55em;
    border-radius: 2px 6px 3px 5px;
    background: var(--marker);
    opacity: 0;
    transform: scaleX(0);
    transform-origin: left center;
    transition:
      transform var(--dur-3) var(--ease-stroke),
      opacity var(--dur-2) var(--ease-out);
  }

  .primary-nav a:hover .nav-label::before {
    opacity: 0.45;
    transform: scaleX(1);
  }

  .primary-nav a[aria-current='page'] {
    color: var(--ink);
    font-weight: 700;
  }

  .primary-nav a[aria-current='page'] .nav-label::before {
    opacity: 1;
    transform: scaleX(1);
    animation: stroke var(--dur-4) var(--ease-stroke) 120ms both;
  }

  @keyframes stroke {
    from {
      transform: scaleX(0);
    }
  }

  .nav-divider {
    inline-size: 1px;
    block-size: 1.25rem;
    margin-inline: var(--space-2);
    background: var(--rule-strong);
  }

  .nav-count {
    min-inline-size: 1.35rem;
    padding: 0.05rem 0.4rem;
    border-radius: var(--radius-pill);
    background: var(--ink);
    color: var(--paper);
    font-size: var(--text-xs);
    font-weight: 700;
    font-variant-numeric: tabular-nums;
    line-height: 1.3;
    text-align: center;
    animation: pop var(--dur-3) var(--ease-turn);
  }

  .nav-signal {
    inline-size: 0.5rem;
    block-size: 0.5rem;
    border-radius: 50%;
    background: var(--rule-strong);
  }

  .nav-signal[data-nav-signal='failed'] {
    background: var(--tone-important);
  }

  .nav-signal[data-nav-signal='busy'] {
    background: var(--accent);
    animation: breathe 1.6s var(--ease-out) infinite alternate;
  }

  @keyframes pop {
    from {
      scale: 0.4;
      opacity: 0;
    }
  }

  @keyframes breathe {
    to {
      box-shadow: 0 0 0 4px var(--accent-wash);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .nav-signal[data-nav-signal='busy'],
    .nav-count,
    .primary-nav a[aria-current='page'] .nav-label::before {
      animation: none;
    }
  }

  .actions {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    margin-inline-start: auto;
  }

  .main {
    width: 100%;
    margin-inline: auto;
    padding: var(--space-7) var(--space-5) var(--space-8);
  }

  .main:focus {
    outline: none;
  }

  .main--wide {
    max-width: 80rem;
  }

  .main--reading {
    max-width: calc(var(--measure) + 2 * var(--space-5));
  }

  .colophon {
    border-block-start: 1px solid var(--rule);
  }

  /* The reader's focus mode (components/reader/useReaderLayout.ts) sets the chrome aside. */
  :global(html[data-reader-focus]) .masthead,
  :global(html[data-reader-focus]) .colophon {
    display: none;
  }

  .colophon-inner {
    justify-content: space-between;
    min-height: 3rem;
    font-family: var(--font-ui);
    font-size: var(--text-xs);
  }

  .colophon-inner a {
    color: var(--ink-3);
  }

  @media (max-width: 52rem) {
    .masthead-inner {
      flex-wrap: wrap;
      gap: 0 var(--space-3);
      padding-inline: var(--space-4);
    }

    /* The nav gets its own row and scrolls sideways rather than wrapping. */
    .primary-nav {
      order: 3;
      width: calc(100% + 2 * var(--space-4));
      margin-inline: calc(-1 * var(--space-4));
      padding-inline: var(--space-2);
      overflow-x: auto;
      scrollbar-width: none;
    }

    .primary-nav ul {
      padding-block-end: var(--space-1);
    }

    .primary-nav a {
      padding-inline: var(--space-2);
      white-space: nowrap;
    }

    .main {
      padding: var(--space-6) var(--space-4) var(--space-7);
    }

    .colophon-inner {
      padding-inline: var(--space-4);
    }
  }
</style>
