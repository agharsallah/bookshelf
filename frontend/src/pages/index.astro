---
import { PUBLIC_APP_NAME, PUBLIC_API_URL } from 'astro:env/client';
import BookCard from '../components/BookCard.astro';
---

<html lang="en">
	<head>
		<meta charset="utf-8" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" />
		<meta name="viewport" content="width=device-width" />
		<meta name="generator" content={Astro.generator} />
		<title>{PUBLIC_APP_NAME}</title>
	</head>
	<body>
		<h1>{PUBLIC_APP_NAME}</h1>
		<p>API: {PUBLIC_API_URL ?? 'not configured'}</p>
		<BookCard title="The Pragmatic Programmer" author="Hunt & Thomas">
			Distilled: fix broken windows early.
		</BookCard>
	</body>
</html>
