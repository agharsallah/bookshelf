---
/**
 * Home. A placeholder until the library lands: it states what the shelf does and
 * shows one distilled passage, cited, in the same components the reader will use.
 */
import BaseLayout from '../layouts/BaseLayout.astro';
import { Blocks } from '../components/blocks/Blocks';
import type { RenderBlock } from '../lib/contract';

const excerpt: RenderBlock[] = [
  {
    type: 'paragraph',
    spans: [
      { text: 'A stock changes only through its flows, so', cites: [] },
      { text: 'it lags behind them', mark: 'highlight', cites: ['ch01/s02/p008'] },
      { text: '. Most of what surprises us about a system lives in that lag.', cites: ['ch01/s04/p002'] },
    ],
  },
  {
    type: 'callout',
    tone: 'remember',
    spans: [{ text: 'Structure produces behaviour. Look for the loop before blaming the actor inside it.', cites: ['ch01/s01/p009'] }],
  },
];
---

<BaseLayout description="Read once, keep forever: cited distillations of the books and articles you read.">
  <div class="home">
    <section class="title-page" aria-labelledby="home-title">
      <h1 id="home-title">Read once,<br />keep forever.</h1>
      <p class="promise">
        Every book on your shelf becomes a chapter-by-chapter distillation and a one-page brief. Each
        claim links back to the passage it came from.
      </p>
      <ul class="links">
        <li><a class="primary" href="/library">Open the library</a></li>
        <li><a href="/styleguide">See the styleguide</a></li>
      </ul>
    </section>

    <figure class="excerpt" aria-labelledby="excerpt-caption">
      <figcaption id="excerpt-caption">
        <cite>Thinking in Systems</cite>, chapter 1, as distilled
      </figcaption>
      <Blocks blocks={excerpt} />
      <p class="hint">The small markers are citations. Hover one to see the passage address.</p>
    </figure>
  </div>
</BaseLayout>

<style>
  .home {
    display: grid;
    grid-template-columns: minmax(0, 1.1fr) minmax(0, 1fr);
    gap: var(--space-8);
    align-items: center;
    min-height: min(32rem, 62dvh);
  }

  h1 {
    font-size: clamp(2.5rem, 6vw, 4.25rem);
    font-weight: 450;
    line-height: 1.02;
    letter-spacing: -0.025em;
  }

  .promise {
    max-width: 30em;
    margin-block-start: var(--space-5);
    font-size: var(--text-md);
    line-height: 1.5;
    color: var(--ink-2);
  }

  .links {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3) var(--space-5);
    align-items: center;
    margin: var(--space-6) 0 0;
    padding: 0;
    list-style: none;
    font-family: var(--font-ui);
    font-size: var(--text-ui);
  }

  .links a {
    color: var(--ink-2);
  }

  .links .primary {
    display: inline-block;
    padding: var(--space-2) var(--space-4);
    border-radius: var(--radius-m);
    background: var(--ink);
    color: var(--paper);
    font-weight: 600;
    text-decoration: none;
    transition: background-color var(--dur-1) var(--ease-out);
  }

  .links .primary:hover {
    background: var(--accent);
  }

  /* The excerpt sits like a leaf laid on the desk: raised paper, a ribbon at the top. */
  .excerpt {
    position: relative;
    padding: var(--space-6) var(--space-5) var(--space-5);
    border: 1px solid var(--rule);
    border-radius: var(--radius-l);
    background: var(--paper-raised);
    box-shadow: var(--shadow-lift);
  }

  .excerpt::before {
    content: '';
    position: absolute;
    inset-block-start: -1px;
    inset-inline-end: var(--space-6);
    width: 0.75rem;
    height: 2.5rem;
    background: var(--accent);
    clip-path: polygon(0 0, 100% 0, 100% 100%, 50% 80%, 0 100%);
  }

  figcaption {
    margin-block-end: var(--space-4);
    font-family: var(--font-ui);
    font-size: var(--text-sm);
    color: var(--ink-3);
  }

  cite {
    font-family: var(--font-read);
    color: var(--ink-2);
  }

  .hint {
    margin-block-start: var(--space-4);
    font-family: var(--font-ui);
    font-size: var(--text-xs);
    color: var(--ink-3);
  }

  @media (max-width: 56rem) {
    .home {
      grid-template-columns: 1fr;
      gap: var(--space-7);
      min-height: 0;
    }
  }
</style>
