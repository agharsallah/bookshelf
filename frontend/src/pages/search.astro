---
/**
 * Search (§10): ask, don't dig. The query lives in the URL (`?q=&mode=&doc=&tag=&type=`),
 * so a search is shareable; the island runs it and streams cited answers. The shelf is
 * loaded here only to offer book and tag filters, and the most connected concepts to
 * suggest before the first query.
 */
import { ActivityBeacon } from '../lib/activity/ActivityBeacon';
import BaseLayout from '../layouts/BaseLayout.astro';
import SearchPage from '../components/search/SearchPage';
import { tagCloud } from '../components/library/filters';
import { parseSearchParams, searchHref } from '../components/search/url-state';
import type { Page } from '../lib/api/types';
import type { DocumentSummary } from '../lib/api/types/documents';
import type { ConceptSummary } from '../lib/api/types/graph';
import { serverApi } from '../lib/api/server';

export const prerender = false;

const initial = parseSearchParams(Astro.url.searchParams);
const askOnLoad = Astro.url.searchParams.get('ask') === '1' && initial.q.trim() !== '';

let documents: { id: string; title: string }[] = [];
let tags: string[] = [];
let suggestions: { label: string; href: string }[] = [];
const api = serverApi();
// Filters and suggestions are optional: search still works if either list is unavailable.
const [shelf, concepts] = await Promise.allSettled([
  api.get<Page<DocumentSummary>>('documents', { query: { limit: 100 } }),
  initial.q ? Promise.resolve(null) : api.get<Page<ConceptSummary>>('concepts', { query: { sort: 'connected', limit: 8 } }),
]);
if (shelf.status === 'fulfilled') {
  documents = shelf.value.items.map((d) => ({ id: d.id, title: d.title })).sort((a, b) => a.title.localeCompare(b.title));
  tags = tagCloud(shelf.value.items).map((t) => t.tag);
}
if (concepts.status === 'fulfilled' && concepts.value) {
  suggestions = concepts.value.items.map((c) => ({ label: c.canonical, href: searchHref({ q: c.canonical }) }));
}
const title = initial.q ? `“${initial.q}”` : 'Search';
---

<BaseLayout title={title} description="Search what you have read, or ask for a cited answer.">
  <ActivityBeacon client:load surface="explore" detail="search" />
  <div class="page">
    <header class="head">
      <h1>Search</h1>
      <p class="lede">What you distilled comes first, then the passages it rests on.</p>
    </header>
    <SearchPage client:load initial={initial} askOnLoad={askOnLoad} documents={documents} tags={tags} suggestions={suggestions} />
  </div>
</BaseLayout>

<style>
  .page {
    display: grid;
    gap: var(--space-5);
    max-inline-size: 60rem;
    padding-block-start: var(--space-4);
  }

  .head {
    display: grid;
    gap: var(--space-2);
    max-inline-size: var(--measure);
  }

  h1 {
    font-size: var(--text-xl);
  }

  .lede {
    color: var(--ink-2);
    font-family: var(--font-ui);
    font-size: var(--text-ui);
  }
</style>
