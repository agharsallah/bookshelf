---
/**
 * Concepts (§11): the index of every concept across your books. The graph is one way
 * to look at them: open a concept in the graph to see its neighbourhood, or the map
 * (`/map`) for the whole shelf at chapter grain. In workshop mode the merge queue sits
 * beside the index, where proposed `same_as` merges wait for a human decision.
 * `?collection=<slug>` narrows the index to the concepts that collection's documents name.
 */
import { ActivityBeacon } from '../../lib/activity/ActivityBeacon';
import BaseLayout from '../../layouts/BaseLayout.astro';
import ConceptBrowser from '../../components/concepts/ConceptBrowser';
import MergeQueue from '../../components/concepts/MergeQueue';
import { Problem, problemOf, type ProblemInfo } from '../../components/common/Problem';
import type { Page } from '../../lib/api/types';
import type { ConceptSummary, MergeProposal } from '../../lib/api/types/graph';
import { serverApi } from '../../lib/api/server';
import { collectionParam } from '../../components/collections/path';
import { getCollection } from '../../lib/collections/api';

export const prerender = false;

const api = serverApi();
const collection = collectionParam(Astro.url.searchParams);
const [concepts, proposals, scoped] = await Promise.allSettled([
  api.get<Page<ConceptSummary>>('concepts', { query: { limit: 40, collection } }),
  api.get<MergeProposal[]>('concepts/merge-proposals', { query: { limit: 50 } }),
  collection ? getCollection(api, collection) : Promise.resolve(null),
]);
const scope = scoped.status === 'fulfilled' ? scoped.value : null;
const initial = concepts.status === 'fulfilled' ? concepts.value : null;
const conceptsProblem: ProblemInfo | null = concepts.status === 'rejected' ? problemOf(concepts.reason) : null;
const queue = proposals.status === 'fulfilled' ? proposals.value : null;
const queueProblem: ProblemInfo | null = proposals.status === 'rejected' ? problemOf(proposals.reason) : null;
---

<BaseLayout title="Concepts" description="The ideas, people and terms your books share, and how they connect.">
  <ActivityBeacon client:idle surface="explore" detail="concepts" />
  <div class="page">
    <header class="head">
      <h1>{scope ? `Concepts in ${scope.name}` : 'Concepts'}</h1>
      {scope && (
        <p class="scope">
          Only the ideas named in the {scope.document_ids.length} documents of <a href={`/collections/${scope.slug}`}>{scope.name}</a>.{' '}
          <a href="/graph">See every concept</a>
        </p>
      )}
      <p class="lede">
        The ideas, frameworks, people and terms your books name, each grounded in the passages that use it. Open one to
        read its gloss and evidence, or open it in the graph to see what it connects to, one neighbourhood at a time.
        Or see <a href="/map">the whole shelf as a map</a>.
      </p>
    </header>

    <div class="columns">
      <section aria-label="All concepts">
        {conceptsProblem ? <Problem title="Concepts could not be loaded." problem={conceptsProblem} /> : <ConceptBrowser client:load initial={initial} collection={collection} />}
      </section>

      <section class="merges workshop-only" aria-labelledby="merge-title">
        <h2 id="merge-title">
          Merges to confirm{queue && queue.length > 0 ? <span class="count">{queue.length}</span> : null}
        </h2>
        <p class="note">Two names that may be one idea. Nothing merges until you say so, and every merge can be undone.</p>
        {queueProblem ? <Problem title="Merge proposals could not be loaded." problem={queueProblem} /> : <MergeQueue client:visible proposals={queue ?? []} />}
      </section>
    </div>
  </div>
</BaseLayout>

<style>
  .page {
    display: grid;
    gap: var(--space-6);
  }

  .head {
    display: grid;
    gap: var(--space-3);
    max-inline-size: var(--measure);
  }

  h1 {
    font-size: var(--text-2xl);
  }

  .scope {
    padding: var(--space-2) var(--space-3);
    border-inline-start: 3px solid var(--accent);
    background: var(--accent-wash);
    font-family: var(--font-ui);
    font-size: var(--text-sm);
  }

  .lede {
    color: var(--ink-2);
    font-family: var(--font-ui);
    font-size: var(--text-base);
    line-height: 1.5;
  }

  .note {
    margin-block-end: var(--space-4);
    color: var(--ink-2);
    font-family: var(--font-ui);
    font-size: var(--text-sm);
  }

  /* Reading mode: the index alone, at a readable width. */
  .columns {
    display: grid;
    grid-template-columns: minmax(0, 52rem);
    align-items: start;
    gap: var(--space-7);
  }

  /* Workshop mode: the merge queue sits beside the index. */
  :global(html[data-workshop]) .columns {
    grid-template-columns: minmax(0, 7fr) minmax(0, 5fr);
  }

  .merges {
    padding-inline-start: var(--space-6);
    border-inline-start: 1px solid var(--rule);
  }

  h2 {
    display: flex;
    align-items: baseline;
    gap: var(--space-2);
    margin-block-end: var(--space-2);
    font-size: var(--text-md);
  }

  .count {
    padding: 0 var(--space-2);
    border-radius: var(--radius-m);
    background: var(--marker);
    color: var(--marker-ink);
    font-family: var(--font-ui);
    font-size: var(--text-sm);
    font-weight: 650;
    font-variant-numeric: tabular-nums;
  }

  @media (max-width: 60rem) {
    .columns,
    :global(html[data-workshop]) .columns {
      grid-template-columns: minmax(0, 1fr);
      gap: var(--space-6);
    }

    .merges {
      padding-inline-start: 0;
      padding-block-start: var(--space-5);
      border-inline-start: none;
      border-block-start: 1px solid var(--rule);
    }
  }
</style>
