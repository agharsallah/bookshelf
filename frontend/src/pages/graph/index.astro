---
/**
 * The idea graph's front door (§11). There is no global view: you pick a concept and
 * see its neighbourhood. Beside the index sits the merge queue, where proposed
 * `same_as` merges wait for a human decision.
 */
import BaseLayout from '../../layouts/BaseLayout.astro';
import ConceptBrowser from '../../components/concepts/ConceptBrowser';
import MergeQueue from '../../components/concepts/MergeQueue';
import { Problem, problemOf, type ProblemInfo } from '../../components/common/Problem';
import type { Page } from '../../lib/api/types';
import type { ConceptSummary, MergeProposal } from '../../lib/api/types/graph';
import { serverApi } from '../../lib/api/server';

export const prerender = false;

const api = serverApi();
const [concepts, proposals] = await Promise.allSettled([
  api.get<Page<ConceptSummary>>('concepts', { query: { limit: 40 } }),
  api.get<MergeProposal[]>('concepts/merge-proposals', { query: { limit: 50 } }),
]);
const initial = concepts.status === 'fulfilled' ? concepts.value : null;
const conceptsProblem: ProblemInfo | null = concepts.status === 'rejected' ? problemOf(concepts.reason) : null;
const queue = proposals.status === 'fulfilled' ? proposals.value : null;
const queueProblem: ProblemInfo | null = proposals.status === 'rejected' ? problemOf(proposals.reason) : null;
---

<BaseLayout title="Graph" description="Concepts across your books, and the merges waiting for you.">
  <div class="page">
    <header class="head">
      <h1>Graph</h1>
      <p class="lede">
        Every concept links out to the passages that ground it, across books. Pick one to see its neighbourhood; nothing
        here is ever shown all at once.
      </p>
    </header>

    <div class="columns">
      <section aria-labelledby="index-title">
        <h2 id="index-title">Concepts</h2>
        {conceptsProblem ? <Problem title="Concepts could not be loaded." problem={conceptsProblem} /> : <ConceptBrowser client:load initial={initial} />}
      </section>

      <section aria-labelledby="merge-title">
        <h2 id="merge-title">
          Merges to confirm{queue && queue.length > 0 ? <span class="count">{queue.length}</span> : null}
        </h2>
        <p class="note">Two names that may be one idea. Nothing merges until you say so, and every merge can be undone.</p>
        {queueProblem ? <Problem title="Merge proposals could not be loaded." problem={queueProblem} /> : <MergeQueue client:visible proposals={queue ?? []} />}
      </section>
    </div>
  </div>
</BaseLayout>

<style>
  .page {
    display: grid;
    gap: var(--space-6);
  }

  .head {
    display: grid;
    gap: var(--space-2);
    max-inline-size: var(--measure);
  }

  h1 {
    font-size: var(--text-xl);
  }

  .lede,
  .note {
    color: var(--ink-2);
  }

  .note {
    margin-block-end: var(--space-4);
    font-size: var(--text-ui);
  }

  .columns {
    display: grid;
    grid-template-columns: minmax(0, 5fr) minmax(0, 6fr);
    align-items: start;
    gap: var(--space-7);
  }

  h2 {
    display: flex;
    align-items: baseline;
    gap: var(--space-2);
    margin-block-end: var(--space-3);
    font-size: var(--text-lg);
  }

  .count {
    padding: 0 var(--space-2);
    border-radius: var(--radius-m);
    background: var(--accent-wash);
    color: var(--accent);
    font-family: var(--font-ui);
    font-size: var(--text-sm);
    font-weight: 600;
  }

  @media (max-width: 60rem) {
    .columns {
      grid-template-columns: minmax(0, 1fr);
      gap: var(--space-6);
    }
  }
</style>
