---
/**
 * The library: every book on the shelf, as spines or as a catalogue list, filtered and
 * ordered by query params (q, author, tag, status, sort). Every book is rendered and
 * the filters hide the rest, so the page's script can filter as you type; without
 * JavaScript the GET form does the same through the server. "Add a book" opens the
 * ingest desk in a dialog.
 */
import BaseLayout from '../../layouts/BaseLayout.astro';
import AddBookButton from '../../components/library/AddBookButton.astro';
import AddBookDialog from '../../components/library/AddBookDialog.astro';
import Catalogue from '../../components/library/Catalogue.astro';
import EmptyShelf from '../../components/library/EmptyShelf.astro';
import FilterBar from '../../components/library/FilterBar.astro';
import Shelf from '../../components/library/Shelf.astro';
import ViewToggle from '../../components/library/ViewToggle.astro';
import { hasFilters, libraryHref, noMatchMessage, parseFilters, resultSummary, tagCloud } from '../../components/library/filters';
import { libraryItems } from '../../components/library/items';
import { loadLibrary } from '../../components/library/load';
import { parseSort } from '../../components/library/sort';
import { DEFAULT_VIEW, viewBootstrapScript, viewClass } from '../../components/library/view';
import { Problem } from '../../components/common/Problem';

export const prerender = false;

const params = Astro.url.searchParams;
const filters = parseFilters(params);
const sort = parseSort(params.get('sort'));
const filtered = hasFilters(filters);

const { documents, problem, files, filesProblem, extras } = await loadLibrary();
const items = libraryItems(documents, extras, filters, sort);
const total = documents.length;
const shown = items.filter((item) => !item.hidden).length;
const waiting = files?.length ?? 0;
const tags = tagCloud(documents);
const label = filtered ? 'Matching books' : 'All books';
const clearHref = libraryHref({ tag: null, status: null, author: null, q: null }, sort);
---

<BaseLayout title="Library" description="Every book and article on your shelf.">
  <div class:list={['library', viewClass(DEFAULT_VIEW)]} data-library>
    <script is:inline data-astro-rerun set:html={viewBootstrapScript} />
    <header class="head">
      <div class="heading">
        <h1>Library</h1>
        <p class="count">
          {total === 0 ? 'Nothing on the shelf yet' : `${resultSummary(total, total, false)} on your shelf`}
        </p>
      </div>
      <AddBookButton waiting={waiting} />
    </header>

    {problem ? (
      <Problem title="The shelf could not be loaded." problem={problem} />
    ) : total === 0 ? (
      <EmptyShelf waiting={waiting} />
    ) : (
      <>
        <FilterBar filters={filters} sort={sort} tags={tags} />

        <div class="results">
          <p class="summary" aria-live="polite">
            <span data-summary>{resultSummary(shown, total, filtered)}</span>
            <a href={clearHref} data-clear hidden={!filtered}>Clear filters</a>
          </p>
          <ViewToggle />
        </div>

        <div class="no-match" data-no-match hidden={shown > 0}>
          <p class="no-match-text" data-no-match-text>{noMatchMessage(filters)}</p>
          <p>
            Try fewer words, or <a href={clearHref} data-clear>clear the filters</a> to see the whole shelf.
          </p>
        </div>

        <div class="view shelf-view">
          <Shelf items={items} label={label} />
        </div>
        <div class="view list-view">
          <Catalogue items={items} label={label} />
        </div>
      </>
    )}

    <AddBookDialog files={files} problem={filesProblem} />
  </div>
</BaseLayout>

<script>
  import { initLibrary } from '../../components/library/live';
  import { onPage } from '../../lib/page';

  onPage((signal) => {
    const root = document.querySelector<HTMLElement>('[data-library]');
    if (root) initLibrary(root, signal);
  });
</script>

<style>
  .library {
    display: grid;
    gap: var(--space-5);
  }

  .head {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-end;
    justify-content: space-between;
    gap: var(--space-3) var(--space-5);
    margin-block-end: var(--space-2);
  }

  .heading {
    display: grid;
    gap: var(--space-1);
  }

  h1 {
    font-size: var(--text-2xl);
    letter-spacing: -0.02em;
    line-height: 1;
  }

  .count {
    color: var(--ink-2);
    font-family: var(--font-ui);
    font-size: var(--text-ui);
  }

  .results {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-3);
    padding-block-start: var(--space-2);
    border-block-start: 1px solid var(--rule);
    font-family: var(--font-ui);
  }

  .summary {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: var(--space-3);
    color: var(--ink-2);
    font-size: var(--text-ui);
    font-variant-numeric: tabular-nums;
  }

  .summary a {
    font-size: var(--text-sm);
  }

  [data-clear][hidden] {
    display: none;
  }

  .no-match {
    display: grid;
    gap: var(--space-2);
    padding: var(--space-6) 0;
    color: var(--ink-2);
    font-family: var(--font-ui);
  }

  .no-match[hidden] {
    display: none;
  }

  .no-match-text {
    color: var(--ink);
    font-size: var(--text-md);
    font-weight: 600;
  }

  .view {
    padding-block-start: var(--space-4);
  }

  .view-shelf .list-view,
  .view-list .shelf-view {
    display: none;
  }

  /* An empty result shows the message, not an empty plank. */
  .library:has([data-no-match]:not([hidden])) .view {
    display: none;
  }

  @media (max-width: 40rem) {
    h1 {
      font-size: var(--text-xl);
    }
  }
</style>
