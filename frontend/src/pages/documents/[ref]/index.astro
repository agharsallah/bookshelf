---
/**
 * Document overview: the title page with where you are in the book (continue reading,
 * the chapter strip), what the book became to study (brief, guide, flashcards…), and the
 * contents. Workshop mode adds the machinery: what each chapter has produced, re-runs,
 * the pipeline with live job progress, making study material, editing the details,
 * archiving or deleting the book and, when the outline was guessed (`needs_review`), the
 * fix-up editor, opened first. An archived book says so at the top, with Restore.
 */
import BaseLayout from '../../../layouts/BaseLayout.astro';
import AddToCollection from '../../../components/collections/AddToCollection';
import ChapterStrip from '../../../components/document/ChapterStrip';
import DocumentActions from '../../../components/document/DocumentActions';
import StudyShelf from '../../../components/document/StudyShelf.astro';
import PaperBanner from '../../../components/papers/PaperBanner.astro';
import DocumentHeader from '../../../components/document/DocumentHeader';
import Outline from '../../../components/document/Outline';
import OutlineEditor from '../../../components/document/OutlineEditor';
import PipelineTimeline from '../../../components/document/PipelineTimeline';
import { Problem } from '../../../components/common/Problem';
import PausedNotice from '../../../components/common/PausedNotice';
import RemoveBook from '../../../components/document/RemoveBook';
import { deriveSkills, madeKey } from '../../../components/document/jobs';
import { outlineFromTree } from '../../../components/document/outline-model';
import { plural } from '../../../components/library/spine';
import type { Page } from '../../../lib/api/types';
import { KIND_LABELS, type ReadingPosition } from '../../../lib/api/types/documents';
import type { JobPublic } from '../../../lib/api/types/jobs';
import type { SkillPublic } from '../../../lib/api/types/skills';
import { chapterStatus, madeIndex, type ChapterStatus } from '../../../lib/documents/artifacts';
import { getArtifacts, getDocument, getOutline, load } from '../../../lib/documents/server';
import { bookProgress, continueTarget, percent, positionsByUnit } from '../../../lib/documents/reading';
import { anchorLabel } from '../../../lib/anchors';
import { availableMaterials, type AvailableMaterial } from '../../../lib/documents/study';
import { defaultUnit, readingUnits } from '../../../lib/documents/tree';
import { serverApi } from '../../../lib/api/server';

export const prerender = false;

const ref = Astro.params.ref ?? '';
const loaded = await load(async () => {
  const doc = await getDocument(ref);
  const [tree, artifacts, jobs, skills, reading] = await Promise.all([
    getOutline(doc.slug),
    getArtifacts(doc.id),
    serverApi().get<Page<JobPublic>>('jobs', { query: { document_id: doc.id, limit: 20 } }),
    // The catalogue only adds the study-material actions; the page works without it.
    serverApi()
      .get<SkillPublic[]>('skills')
      .catch(() => []),
    // Progress only adds "continue reading"; the page works without it.
    serverApi()
      .get<ReadingPosition[]>(`documents/${encodeURIComponent(doc.slug)}/reading`)
      .catch(() => []),
  ]);
  return { doc, tree, artifacts, jobs: jobs.items, skills, reading };
});
if (!loaded.ok && loaded.notFound) Astro.response.status = 404;

const data = loaded.ok ? loaded.value : null;
const units = data ? readingUnits(data.tree.nodes) : [];
const statuses: Record<string, ChapterStatus> = Object.fromEntries(
  units.map((u) => [u.anchor, chapterStatus(data?.artifacts ?? [], u.anchor)]),
);
const first = defaultUnit(units);
const reading = data?.reading ?? [];
const positions = positionsByUnit(reading, units);
const resume = continueTarget(reading, units);
const book = bookProgress(reading, units);
const started = Object.keys(positions).length > 0;
const unitName = (unit: (typeof units)[number]) =>
  [unit.meta.front_matter ? null : anchorLabel(unit.anchor), unit.heading].filter(Boolean).join(' · ');
// Study material waits for a confirmed outline: it reads the chapters as parsed.
const deriving = data !== null && data.doc.status !== 'needs_review';
const chapterDerive = data && deriving ? deriveSkills(data.skills, 'chapter', data.doc.genre) : [];
const documentDerive = data && deriving ? deriveSkills(data.skills, 'document', data.doc.genre) : [];
const listenable = Boolean(data?.skills.some((s) => s.narrate));
const distilled = Object.values(statuses).some((s) => s.distillation === 'approved');
const made = data ? madeIndex(data.artifacts, [...chapterDerive, ...documentDerive], madeKey) : {};
const parsed = data !== null && !['registered', 'parsing', 'parse_failed'].includes(data.doc.status);
const needsReview = data?.doc.status === 'needs_review';
const editable = data !== null && data.doc.kind === 'pdf' && parsed;
const outline = data
  ? data.doc.outline_override && data.doc.outline_override.length > 0
    ? data.doc.outline_override
    : outlineFromTree(data.tree.nodes, data.doc.page_count)
  : [];
const facts = data
  ? [
      KIND_LABELS[data.doc.kind],
      data.doc.page_count ? `${data.doc.page_count} pages` : null,
      data.doc.counts.figures ? plural(data.doc.counts.figures, 'figure') : null,
      data.doc.counts.notes ? plural(data.doc.counts.notes, 'note') : null,
    ]
      .filter(Boolean)
      .join(', ')
  : '';
const exportsBase = data ? `/api/exports/${data.doc.slug}` : '';
const study = data ? availableMaterials(data.doc.slug, data.artifacts) : [];
const chapterStudy: Record<string, AvailableMaterial[]> = data
  ? Object.fromEntries(
      units.map((u) => [u.anchor, availableMaterials(data.doc.slug, data.artifacts, u.anchor)]).filter(([, found]) => found.length > 0),
    )
  : {};
const added = data ? new Date(data.doc.created_at).toLocaleDateString('en-GB', { day: 'numeric', month: 'long', year: 'numeric' }) : '';
---

<BaseLayout title={data?.doc.title ?? 'Document'}>
  {
    !data ? (
      <div class="missing">
        {!loaded.ok && loaded.notFound ? (
          <>
            <h1>Not on the shelf</h1>
            <p>
              No document is called “{ref}”. <a href="/library">Back to the library</a>
            </p>
          </>
        ) : (
          !loaded.ok && <Problem title="The document could not be loaded." problem={loaded.problem} />
        )}
      </div>
    ) : (
      <article class="document">
        <header class="title-page">
          <nav class="crumbs" aria-label="Breadcrumb">
            <a href="/library">
              <span aria-hidden="true">←</span> Library
            </a>
          </nav>
          <DocumentHeader
            client:visible
            slug={data.doc.slug}
            initial={{ title: data.doc.title, authors: data.doc.authors, year: data.doc.year, tags: data.doc.tags }}
            facts={facts}
          />
          <AddToCollection client:visible documentId={data.doc.id} />
          <div class="reading">
            <div class="primary-actions">
              {parsed && resume ? (
                <a class="read" href={`/documents/${data.doc.slug}/read/${resume.anchor}`}>
                  <span>{resume.kind === 'continue' ? 'Continue reading' : 'Read the next chapter'}</span>
                  <span class="read-where">
                    {unitName(resume.unit)}
                    {resume.progress > 0 ? `, ${percent(resume.progress)}%` : ''}
                  </span>
                </a>
              ) : (
                first &&
                parsed && (
                  <a class="read" href={`/documents/${data.doc.slug}/read/${first.anchor}`}>
                    {started ? 'Read again' : 'Start reading'}
                  </a>
                )
              )}
              {parsed && (
                <p class="book-progress">
                  {started ? (
                    <>
                      <strong>{percent(book.progress)}% read</strong>
                      <span>
                        {book.finished} of {plural(book.total, 'chapter')} finished
                      </span>
                    </>
                  ) : (
                    <span>Not started yet</span>
                  )}
                </p>
              )}
            </div>
            {parsed && units.length > 0 && (
              <div
                class="strip"
                role="group"
                aria-label="Progress through the book"
                data-progress={percent(book.progress)}
              >
                <ChapterStrip slug={data.doc.slug} units={units} positions={positions} current={resume?.unit.anchor ?? null} size="lg" />
              </div>
            )}
          </div>
        </header>

        {data.doc.genre === 'paper' && <PaperBanner slug={data.doc.slug} />}

        {parsed && (
          <section class="study" aria-labelledby="study-this-title">
            <h2 id="study-this-title" class="section-title">{data.doc.genre === 'paper' ? 'Study this paper' : 'Study this book'}</h2>
            <StudyShelf materials={study} />
          </section>
        )}

        <div class="columns">
          <div class="main-col">
            {data.doc.archived_at && (
              <RemoveBook
                client:load
                documentRef={data.doc.slug}
                title={data.doc.title}
                sourcePath={data.doc.source_path}
                archivedAt={data.doc.archived_at}
              />
            )}
            {data.doc.paused && (
              <div class="workshop-only">
                <PausedNotice client:load documentRef={data.doc.slug} paused={data.doc.paused} />
              </div>
            )}
            {needsReview && (
              <section class="review-banner workshop-only" aria-labelledby="fix-title">
                <h2 id="fix-title">Check the chapters before distillation</h2>
                <p>
                  This document had no usable table of contents, so its chapters were guessed from headings. Fix the
                  outline below (it is kept across re-parses), or confirm it there if the guess is right.
                </p>
              </section>
            )}

            <section aria-labelledby="contents-title">
              <h2 id="contents-title" class="section-title">Contents</h2>
              <Outline
                client:visible
                documentId={data.doc.id}
                slug={data.doc.slug}
                units={units}
                statuses={statuses}
                actionable={parsed}
                derive={chapterDerive}
                initialJobs={data.jobs}
                made={made}
                positions={positions}
                study={chapterStudy}
                current={resume?.unit.anchor ?? null}
              />
            </section>

            {editable && (
              <details class="fixup workshop-only" open={needsReview}>
                <summary>
                  <span class="fixup-title">Fix the outline</span>
                  <span class="fixup-hint">Rename, merge or split chapters and adjust their pages.</span>
                </summary>
                <OutlineEditor
                  client:visible
                  slug={data.doc.slug}
                  initial={outline}
                  pageCount={data.doc.page_count}
                  hasOverride={Boolean(data.doc.outline_override?.length)}
                  needsReview={needsReview}
                />
              </details>
            )}
          </div>

          {parsed && documentDerive.length > 0 && (
            <aside class="side side-material workshop-only" aria-labelledby="study-title">
              <section class="card">
                <h2 id="study-title" class="side-title">Make study material</h2>
                <p class="side-hint">For the whole book. Each chapter’s own sets are made from its details.</p>
                <DocumentActions
                  client:visible
                  documentId={data.doc.id}
                  derive={documentDerive}
                  distilled={distilled}
                  initialJobs={data.jobs}
                  made={made}
                />
                {listenable && (
                  <p class="side-hint">
                    <a href={`/documents/${data.doc.slug}/listen`}>Make an audio summary</a>: 5, 15 or 30 minutes, one to four voices.
                  </p>
                )}
              </section>
            </aside>
          )}

          <aside class="side side-ops" aria-label="About this book">
            <section class="card reading-only" aria-labelledby="about-title">
              <h2 id="about-title" class="side-title">About this book</h2>
              <dl class="facts">
                <div><dt>Chapters</dt><dd>{units.filter((u) => !u.meta.front_matter).length}</dd></div>
                {data.doc.page_count ? <div><dt>Pages</dt><dd>{data.doc.page_count}</dd></div> : null}
                {data.doc.counts.figures ? <div><dt>Figures</dt><dd>{data.doc.counts.figures}</dd></div> : null}
                {data.doc.counts.notes ? <div><dt>Your notes</dt><dd>{data.doc.counts.notes}</dd></div> : null}
                <div><dt>Added</dt><dd>{added}</dd></div>
              </dl>
            </section>

            <div class="card workshop-only">
              <PipelineTimeline
                client:visible
                documentId={data.doc.id}
                slug={data.doc.slug}
                initialStatus={data.doc.status}
                initialJobs={data.jobs}
              />
            </div>

            <section aria-labelledby="run-title" class="card workshop-only">
              <h2 id="run-title" class="side-title">Run again</h2>
              <p class="side-hint">Re-parsing rebuilds the outline from the file.</p>
              <DocumentActions client:visible documentId={data.doc.id} kinds={parsed ? ['parse', 'brief'] : ['parse']} />
            </section>

            <section aria-labelledby="export-title" class="card">
              <h2 id="export-title" class="side-title">Export</h2>
              <ul class="exports">
                <li><a href={`${exportsBase}.md`}>Markdown</a><span>with anchors and approved artifacts</span></li>
                <li><a href={`${exportsBase}.json`}>JSON</a><span>in the render contract</span></li>
                <li><a href={`${exportsBase}/tables.csv`}>Tables</a><span>as CSV</span></li>
              </ul>
              <p class="source workshop-only">
                {data.doc.source_uri ? <a href={data.doc.source_uri}>Original article</a> : data.doc.source_path}
              </p>
            </section>

            {!data.doc.archived_at && (
              <section aria-labelledby="remove-title" class="card workshop-only">
                <h2 id="remove-title" class="side-title">Off the shelf</h2>
                <p class="side-hint">Archive it to put it away with everything kept, or delete it for good.</p>
                <RemoveBook
                  client:visible
                  documentRef={data.doc.slug}
                  title={data.doc.title}
                  sourcePath={data.doc.source_path}
                  archivedAt={null}
                />
              </section>
            )}
          </aside>
        </div>
      </article>
    )
  }
</BaseLayout>

<style>
  .document {
    display: grid;
    gap: var(--space-7);
  }

  .title-page {
    display: grid;
    gap: var(--space-5);
    padding-block-end: var(--space-6);
    border-block-end: 1px solid var(--rule);
  }

  .crumbs {
    font-family: var(--font-ui);
    font-size: var(--text-sm);
  }

  .crumbs a {
    color: var(--ink-3);
    text-decoration: none;
  }

  .crumbs a:hover {
    color: var(--accent);
  }

  /* Reading first: the one filled button, then what the book became, then how far you are. */
  .reading {
    display: grid;
    gap: var(--space-4);
  }

  .primary-actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3) var(--space-5);
    align-items: center;
    font-family: var(--font-ui);
    font-size: var(--text-ui);
  }

  .read {
    display: inline-flex;
    flex-direction: column;
    justify-content: center;
    min-block-size: 3rem;
    padding: var(--space-2) var(--space-5);
    border-radius: var(--radius-m);
    background: var(--accent);
    color: var(--on-accent);
    font-weight: 700;
    text-decoration: none;
    transition: background var(--dur-1) var(--ease-out);
  }

  .read:hover {
    background: var(--accent-strong);
    text-decoration: none;
  }

  .read-where {
    display: block;
    max-inline-size: 32ch;
    overflow: hidden;
    font-size: var(--text-xs);
    font-weight: 400;
    opacity: 0.85;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .book-progress {
    display: grid;
    color: var(--ink-3);
    font-family: var(--font-ui);
    font-size: var(--text-sm);
    font-variant-numeric: tabular-nums;
  }

  .book-progress strong {
    color: var(--ink);
    font-size: var(--text-lg);
    font-weight: 700;
    letter-spacing: -0.02em;
    line-height: 1.1;
  }

  /* The one moment on arrival: what you have read inks itself into the strip. */
  .strip :global(li span[aria-hidden='true']) {
    animation: ink-in var(--dur-4) var(--ease-stroke) 200ms both;
    transform-origin: left center;
  }

  @keyframes ink-in {
    from {
      transform: scaleX(0);
    }
  }

  .study {
    display: grid;
    gap: var(--space-2);
  }

  .facts {
    display: grid;
    gap: var(--space-2);
    margin: 0;
    font-family: var(--font-ui);
    font-size: var(--text-sm);
  }

  .facts div {
    display: flex;
    justify-content: space-between;
    gap: var(--space-3);
    padding-block-end: var(--space-2);
    border-block-end: 1px dotted var(--rule);
  }

  .facts dt {
    color: var(--ink-3);
  }

  .facts dd {
    margin: 0;
    color: var(--ink);
    font-weight: 600;
    font-variant-numeric: tabular-nums;
  }

  /* The contents on the left; the book-wide study material, then the pipeline, on the right. */
  .columns {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 19rem;
    grid-template-rows: auto 1fr;
    grid-template-areas:
      'main material'
      'main ops';
    column-gap: var(--space-7);
    align-items: start;
  }

  .main-col {
    grid-area: main;
    display: grid;
    gap: var(--space-6);
  }

  .section-title {
    margin-block-end: var(--space-2);
    font-size: var(--text-lg);
    font-weight: 500;
  }

  .review-banner {
    padding: var(--space-4) var(--space-5);
    border-inline-start: 3px solid var(--tone-caution);
    background: color-mix(in oklab, var(--tone-caution) 8%, var(--paper-raised));
  }

  .review-banner h2 {
    font-size: var(--text-md);
  }

  .review-banner p {
    margin-block-start: var(--space-2);
    color: var(--ink-2);
    font-size: var(--text-ui);
  }

  .fixup {
    padding: var(--space-4) var(--space-5);
    border: 1px solid var(--rule);
    border-radius: var(--radius-l);
    background: var(--paper-raised);
  }

  .fixup > summary {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: var(--space-2) var(--space-4);
    cursor: pointer;
  }

  .fixup[open] > summary {
    margin-block-end: var(--space-4);
  }

  .fixup-title {
    font-size: var(--text-md);
    font-weight: 560;
  }

  .fixup-hint {
    color: var(--ink-3);
    font-family: var(--font-ui);
    font-size: var(--text-sm);
  }

  .side {
    display: grid;
    gap: var(--space-4);
  }

  .side-material {
    grid-area: material;
    margin-block-end: var(--space-4);
  }

  .side-ops {
    grid-area: ops;
  }

  .card {
    display: grid;
    gap: var(--space-3);
    padding: var(--space-4) var(--space-5);
    border: 1px solid var(--rule);
    border-radius: var(--radius-l);
    background: var(--paper-raised);
  }

  .side-title {
    font-size: var(--text-md);
    font-weight: 560;
  }

  .side-hint {
    margin-block-start: calc(-1 * var(--space-2));
    color: var(--ink-3);
    font-family: var(--font-ui);
    font-size: var(--text-sm);
  }

  .exports {
    display: grid;
    gap: var(--space-2);
    margin: 0;
    padding: 0;
    list-style: none;
    font-family: var(--font-ui);
    font-size: var(--text-sm);
  }

  .exports li {
    display: flex;
    flex-wrap: wrap;
    gap: 0 var(--space-2);
    align-items: baseline;
  }

  .exports a {
    font-weight: 600;
  }

  .exports span {
    color: var(--ink-3);
    font-size: var(--text-xs);
  }

  .source {
    padding-block-start: var(--space-3);
    border-block-start: 1px solid var(--rule);
    overflow-wrap: anywhere;
    color: var(--ink-3);
    font-family: var(--font-mono);
    font-size: var(--text-xs);
  }

  .missing {
    display: grid;
    gap: var(--space-3);
  }

  @media (max-width: 56rem) {
    .columns {
      grid-template-columns: minmax(0, 1fr);
      grid-template-rows: none;
      grid-template-areas:
        'main'
        'material'
        'ops';
      row-gap: var(--space-6);
    }

    .side-material {
      margin-block-end: 0;
    }
  }

  @media (max-width: 40rem) {
    .primary-actions > * {
      flex: 1 1 auto;
    }

    .read {
      flex-basis: 100%;
    }

    .card {
      padding: var(--space-4);
    }
  }
</style>
