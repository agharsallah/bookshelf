---
/**
 * Document overview: the title page (editable details), the outline with what each
 * chapter has produced, the pipeline with live job progress, exports and actions, and
 * how far you have read, with a way to continue where you left off.
 * When the outline was guessed (`needs_review`) the fix-up editor opens first.
 */
import BaseLayout from '../../../layouts/BaseLayout.astro';
import DocumentActions from '../../../components/document/DocumentActions';
import DocumentHeader from '../../../components/document/DocumentHeader';
import Outline from '../../../components/document/Outline';
import OutlineEditor from '../../../components/document/OutlineEditor';
import PipelineTimeline from '../../../components/document/PipelineTimeline';
import { Problem } from '../../../components/common/Problem';
import PausedNotice from '../../../components/common/PausedNotice';
import { deriveSkills, madeKey } from '../../../components/document/jobs';
import { outlineFromTree } from '../../../components/document/outline-model';
import { plural } from '../../../components/library/spine';
import type { Page } from '../../../lib/api/types';
import type { ReadingPosition } from '../../../lib/api/types/documents';
import type { JobPublic } from '../../../lib/api/types/jobs';
import type { SkillPublic } from '../../../lib/api/types/skills';
import { chapterStatus, madeIndex, pickBest, type ChapterStatus } from '../../../lib/documents/artifacts';
import { getArtifacts, getDocument, getOutline, load } from '../../../lib/documents/server';
import { bookProgress, continueTarget, percent, positionsByUnit } from '../../../lib/documents/reading';
import { anchorLabel } from '../../../lib/anchors';
import { defaultUnit, readingUnits } from '../../../lib/documents/tree';
import { serverApi } from '../../../lib/api/server';

export const prerender = false;

const ref = Astro.params.ref ?? '';
const loaded = await load(async () => {
  const doc = await getDocument(ref);
  const [tree, artifacts, jobs, skills, reading] = await Promise.all([
    getOutline(doc.slug),
    getArtifacts(doc.id),
    serverApi().get<Page<JobPublic>>('jobs', { query: { document_id: doc.id, limit: 20 } }),
    // The catalogue only adds the study-material actions; the page works without it.
    serverApi()
      .get<SkillPublic[]>('skills')
      .catch(() => []),
    // Progress only adds "continue reading"; the page works without it.
    serverApi()
      .get<ReadingPosition[]>(`documents/${encodeURIComponent(doc.slug)}/reading`)
      .catch(() => []),
  ]);
  return { doc, tree, artifacts, jobs: jobs.items, skills, reading };
});
if (!loaded.ok && loaded.notFound) Astro.response.status = 404;

const data = loaded.ok ? loaded.value : null;
const units = data ? readingUnits(data.tree.nodes) : [];
const statuses: Record<string, ChapterStatus> = Object.fromEntries(
  units.map((u) => [u.anchor, chapterStatus(data?.artifacts ?? [], u.anchor)]),
);
const brief = data ? pickBest(data.artifacts, 'book_brief', null) : null;
const guide = data ? pickBest(data.artifacts, 'book_guide', null) : null;
const first = defaultUnit(units);
const reading = data?.reading ?? [];
const positions = positionsByUnit(reading, units);
const resume = continueTarget(reading, units);
const book = bookProgress(reading, units);
const started = Object.keys(positions).length > 0;
const unitName = (unit: (typeof units)[number]) =>
  [unit.meta.front_matter ? null : anchorLabel(unit.anchor), unit.heading].filter(Boolean).join(' · ');
// Study material waits for a confirmed outline: it reads the chapters as parsed.
const deriving = data !== null && data.doc.status !== 'needs_review';
const chapterDerive = data && deriving ? deriveSkills(data.skills, 'chapter') : [];
const documentDerive = data && deriving ? deriveSkills(data.skills, 'document') : [];
const distilled = Object.values(statuses).some((s) => s.distillation === 'approved');
const made = data ? madeIndex(data.artifacts, [...chapterDerive, ...documentDerive], madeKey) : {};
const parsed = data !== null && !['registered', 'parsing', 'parse_failed'].includes(data.doc.status);
const needsReview = data?.doc.status === 'needs_review';
const editable = data !== null && data.doc.kind === 'pdf' && parsed;
const outline = data
  ? data.doc.outline_override && data.doc.outline_override.length > 0
    ? data.doc.outline_override
    : outlineFromTree(data.tree.nodes, data.doc.page_count)
  : [];
const facts = data
  ? [
      data.doc.kind === 'pdf' ? 'PDF' : 'Article',
      data.doc.page_count ? `${data.doc.page_count} pages` : null,
      data.doc.counts.figures ? plural(data.doc.counts.figures, 'figure') : null,
      data.doc.counts.notes ? plural(data.doc.counts.notes, 'note') : null,
    ]
      .filter(Boolean)
      .join(', ')
  : '';
const exportsBase = data ? `/api/exports/${data.doc.slug}` : '';
---

<BaseLayout title={data?.doc.title ?? 'Document'}>
  {
    !data ? (
      <div class="missing">
        {!loaded.ok && loaded.notFound ? (
          <>
            <h1>Not on the shelf</h1>
            <p>
              No document is called “{ref}”. <a href="/library">Back to the library</a>
            </p>
          </>
        ) : (
          !loaded.ok && <Problem title="The document could not be loaded." problem={loaded.problem} />
        )}
      </div>
    ) : (
      <article class="document">
        <header class="title-page">
          <nav class="crumbs" aria-label="Breadcrumb">
            <a href="/library">
              <span aria-hidden="true">←</span> Library
            </a>
          </nav>
          <DocumentHeader
            client:visible
            slug={data.doc.slug}
            initial={{ title: data.doc.title, authors: data.doc.authors, year: data.doc.year, tags: data.doc.tags }}
            facts={facts}
          />
          <div class="reading">
            <div class="primary-actions">
              {parsed && resume ? (
                <a class="read" href={`/documents/${data.doc.slug}/read/${resume.anchor}`}>
                  <span>{resume.kind === 'continue' ? 'Continue reading' : 'Read the next chapter'}</span>
                  <span class="read-where">
                    {unitName(resume.unit)}
                    {resume.progress > 0 ? `, ${percent(resume.progress)}%` : ''}
                  </span>
                </a>
              ) : (
                first &&
                parsed && (
                  <a class="read" href={`/documents/${data.doc.slug}/read/${first.anchor}`}>
                    {started ? 'Read again' : 'Start reading'}
                  </a>
                )
              )}
              {brief ? (
                <a class="secondary" href={`/documents/${data.doc.slug}/brief`}>
                  Brief
                  {brief.standing !== 'approved' && <span class="pill">draft</span>}
                </a>
              ) : null}
              {guide ? (
                <a class="secondary" href={`/documents/${data.doc.slug}/guide`}>
                  Book guide
                  {guide.standing !== 'approved' && <span class="pill">draft</span>}
                </a>
              ) : null}
            </div>
            {parsed && started && (
              <div class="book-progress">
                <div
                  class="book-meter"
                  role="progressbar"
                  aria-label="Progress through the book"
                  aria-valuemin={0}
                  aria-valuemax={100}
                  aria-valuenow={percent(book.progress)}
                >
                  <span style={`inline-size: ${percent(book.progress)}%`} />
                </div>
                <p>
                  <strong>{percent(book.progress)}% read</strong> · {book.finished} of {plural(book.total, 'chapter')} finished
                </p>
              </div>
            )}
          </div>
        </header>

        <div class="columns">
          <div class="main-col">
            {data.doc.paused && <PausedNotice client:load documentRef={data.doc.slug} paused={data.doc.paused} />}
            {needsReview && (
              <section class="review-banner" aria-labelledby="fix-title">
                <h2 id="fix-title">Check the chapters before distillation</h2>
                <p>
                  This document had no usable table of contents, so its chapters were guessed from headings. Fix the
                  outline below (it is kept across re-parses), or confirm it there if the guess is right.
                </p>
              </section>
            )}

            <section aria-labelledby="contents-title">
              <h2 id="contents-title" class="section-title">Contents</h2>
              <Outline
                client:visible
                documentId={data.doc.id}
                slug={data.doc.slug}
                units={units}
                statuses={statuses}
                actionable={parsed}
                derive={chapterDerive}
                initialJobs={data.jobs}
                made={made}
                positions={positions}
              />
            </section>

            {editable && (
              <details class="fixup" open={needsReview}>
                <summary>
                  <span class="fixup-title">Fix the outline</span>
                  <span class="fixup-hint">Rename, merge or split chapters and adjust their pages.</span>
                </summary>
                <OutlineEditor
                  client:visible
                  slug={data.doc.slug}
                  initial={outline}
                  pageCount={data.doc.page_count}
                  hasOverride={Boolean(data.doc.outline_override?.length)}
                  needsReview={needsReview}
                />
              </details>
            )}
          </div>

          {parsed && documentDerive.length > 0 && (
            <aside class="side side-material" aria-labelledby="study-title">
              <section class="card">
                <h2 id="study-title" class="side-title">Study material</h2>
                <p class="side-hint">For the whole book. Each chapter’s own quiz, FAQ, quotes and flashcards are in its details.</p>
                <DocumentActions
                  client:visible
                  documentId={data.doc.id}
                  derive={documentDerive}
                  distilled={distilled}
                  initialJobs={data.jobs}
                  made={made}
                />
              </section>
            </aside>
          )}

          <aside class="side side-ops" aria-label="Pipeline and exports">
            <div class="card">
              <PipelineTimeline
                client:load
                documentId={data.doc.id}
                slug={data.doc.slug}
                initialStatus={data.doc.status}
                initialJobs={data.jobs}
              />
            </div>

            <section aria-labelledby="run-title" class="card">
              <h2 id="run-title" class="side-title">Run again</h2>
              <p class="side-hint">Re-parsing rebuilds the outline from the file.</p>
              <DocumentActions client:visible documentId={data.doc.id} kinds={parsed ? ['parse', 'brief'] : ['parse']} />
            </section>

            <section aria-labelledby="export-title" class="card">
              <h2 id="export-title" class="side-title">Export</h2>
              <ul class="exports">
                <li><a href={`${exportsBase}.md`}>Markdown</a><span>with anchors and approved artifacts</span></li>
                <li><a href={`${exportsBase}.json`}>JSON</a><span>in the render contract</span></li>
                <li><a href={`${exportsBase}/tables.csv`}>Tables</a><span>as CSV</span></li>
              </ul>
              <p class="source">
                {data.doc.source_uri ? <a href={data.doc.source_uri}>Original article</a> : data.doc.source_path}
              </p>
            </section>
          </aside>
        </div>
      </article>
    )
  }
</BaseLayout>

<style>
  .document {
    display: grid;
    gap: var(--space-7);
  }

  .title-page {
    display: grid;
    gap: var(--space-5);
    padding-block-end: var(--space-6);
    border-block-end: 1px solid var(--rule);
  }

  .crumbs {
    font-family: var(--font-ui);
    font-size: var(--text-sm);
  }

  .crumbs a {
    color: var(--ink-3);
    text-decoration: none;
  }

  .crumbs a:hover {
    color: var(--accent);
  }

  /* Reading first: the one filled button, then what the book became, then how far you are. */
  .reading {
    display: grid;
    gap: var(--space-4);
  }

  .primary-actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
    align-items: stretch;
    font-family: var(--font-ui);
    font-size: var(--text-ui);
  }

  .read,
  .secondary {
    display: inline-flex;
    flex-direction: column;
    justify-content: center;
    min-block-size: 2.75rem;
    padding: var(--space-2) var(--space-5);
    border-radius: var(--radius-m);
    font-weight: 600;
    text-decoration: none;
    transition:
      background var(--dur-1) var(--ease-out),
      border-color var(--dur-1) var(--ease-out);
  }

  .read {
    background: var(--ink);
    color: var(--paper);
  }

  .read:hover {
    background: var(--accent);
  }

  .secondary {
    flex-direction: row;
    align-items: center;
    gap: var(--space-2);
    border: 1px solid var(--rule-strong);
    background: var(--paper-raised);
    color: var(--ink);
  }

  .secondary:hover {
    border-color: var(--accent);
    color: var(--accent);
  }

  .pill {
    padding: 0 var(--space-2);
    border: 1px dashed var(--tone-caution);
    border-radius: 999px;
    color: var(--tone-caution);
    font-size: var(--text-xs);
    font-weight: 500;
  }

  .read-where {
    display: block;
    max-inline-size: 32ch;
    overflow: hidden;
    font-size: var(--text-xs);
    font-weight: 400;
    opacity: 0.85;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .book-progress {
    display: grid;
    gap: var(--space-2);
    max-inline-size: 28rem;
    color: var(--ink-3);
    font-family: var(--font-ui);
    font-size: var(--text-sm);
    font-variant-numeric: tabular-nums;
  }

  .book-progress strong {
    color: var(--ink-2);
    font-weight: 600;
  }

  .book-meter {
    block-size: 6px;
    border-radius: 3px;
    background: var(--rule);
    overflow: hidden;
  }

  .book-meter span {
    display: block;
    block-size: 100%;
    background: var(--accent);
  }

  /* The contents on the left; the book-wide study material, then the pipeline, on the right. */
  .columns {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 19rem;
    grid-template-rows: auto 1fr;
    grid-template-areas:
      'main material'
      'main ops';
    column-gap: var(--space-7);
    align-items: start;
  }

  .main-col {
    grid-area: main;
    display: grid;
    gap: var(--space-6);
  }

  .section-title {
    margin-block-end: var(--space-2);
    font-size: var(--text-lg);
    font-weight: 500;
  }

  .review-banner {
    padding: var(--space-4) var(--space-5);
    border-inline-start: 3px solid var(--tone-caution);
    background: color-mix(in oklab, var(--tone-caution) 8%, var(--paper-raised));
  }

  .review-banner h2 {
    font-size: var(--text-md);
  }

  .review-banner p {
    margin-block-start: var(--space-2);
    color: var(--ink-2);
    font-size: var(--text-ui);
  }

  .fixup {
    padding: var(--space-4) var(--space-5);
    border: 1px solid var(--rule);
    border-radius: var(--radius-l);
    background: var(--paper-raised);
  }

  .fixup > summary {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: var(--space-2) var(--space-4);
    cursor: pointer;
  }

  .fixup[open] > summary {
    margin-block-end: var(--space-4);
  }

  .fixup-title {
    font-size: var(--text-md);
    font-weight: 560;
  }

  .fixup-hint {
    color: var(--ink-3);
    font-family: var(--font-ui);
    font-size: var(--text-sm);
  }

  .side {
    display: grid;
    gap: var(--space-4);
  }

  .side-material {
    grid-area: material;
    margin-block-end: var(--space-4);
  }

  .side-ops {
    grid-area: ops;
  }

  .card {
    display: grid;
    gap: var(--space-3);
    padding: var(--space-4) var(--space-5);
    border: 1px solid var(--rule);
    border-radius: var(--radius-l);
    background: var(--paper-raised);
  }

  .side-title {
    font-size: var(--text-md);
    font-weight: 560;
  }

  .side-hint {
    margin-block-start: calc(-1 * var(--space-2));
    color: var(--ink-3);
    font-family: var(--font-ui);
    font-size: var(--text-sm);
  }

  .exports {
    display: grid;
    gap: var(--space-2);
    margin: 0;
    padding: 0;
    list-style: none;
    font-family: var(--font-ui);
    font-size: var(--text-sm);
  }

  .exports li {
    display: flex;
    flex-wrap: wrap;
    gap: 0 var(--space-2);
    align-items: baseline;
  }

  .exports a {
    font-weight: 600;
  }

  .exports span {
    color: var(--ink-3);
    font-size: var(--text-xs);
  }

  .source {
    padding-block-start: var(--space-3);
    border-block-start: 1px solid var(--rule);
    overflow-wrap: anywhere;
    color: var(--ink-3);
    font-family: var(--font-mono);
    font-size: var(--text-xs);
  }

  .missing {
    display: grid;
    gap: var(--space-3);
  }

  @media (max-width: 56rem) {
    .columns {
      grid-template-columns: minmax(0, 1fr);
      grid-template-rows: none;
      grid-template-areas:
        'main'
        'material'
        'ops';
      row-gap: var(--space-6);
    }

    .side-material {
      margin-block-end: 0;
    }
  }

  @media (max-width: 40rem) {
    .primary-actions > * {
      flex: 1 1 auto;
    }

    .read {
      flex-basis: 100%;
    }

    .card {
      padding: var(--space-4);
    }
  }
</style>
