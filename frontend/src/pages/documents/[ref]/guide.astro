---
/**
 * The book guide: the best `book_guide` (approved, else the newest draft, badged as one),
 * with its charts computed from the document tree — each chapter's reading time, its
 * role, and where each theme is cited. Without a guide, says how to get one.
 */
import BaseLayout from '../../../layouts/BaseLayout.astro';
import GuideSheet from '../../../components/guide/GuideSheet.astro';
import { chapterLabel, chapterRows, glance, parseGuide, readableMap, unitOf } from '../../../components/guide/guide';
import { Problem } from '../../../components/common/Problem';
import { pickBest } from '../../../lib/documents/artifacts';
import StudySwitcher from '../../../components/study/StudySwitcher.astro';
import { switcherItems } from '../../../components/study/study-page';
import { getDocument, getFullTree, getStudyArtifacts, load } from '../../../lib/documents/server';
import { availableMaterials } from '../../../lib/documents/study';
import { readingUnits } from '../../../lib/documents/tree';
import { prepareBlocks } from '../../../lib/prepare';

export const prerender = false;

const ref = Astro.params.ref ?? '';
const loaded = await load(async () => {
  const doc = await getDocument(ref);
  const study = await getStudyArtifacts(doc.id);
  const items = switcherItems(doc.slug, availableMaterials(doc.slug, study), 'guide');
  const guides = study.filter((a) => a.type === 'book_guide');
  const briefs = study.filter((a) => a.type === 'book_brief' && a.review === 'approved');
  const best = pickBest(guides, 'book_guide', null);
  const guide = best ? parseGuide(best.artifact.body) : null;
  const hasBrief = briefs.length > 0;
  if (!best || !guide) return { doc, items, hasBrief, sheet: null };
  const [tree, sections] = await Promise.all([
    getFullTree(doc.slug),
    Promise.all(
      guide.sections.map(async (s) => ({ ...s, blocks: await prepareBlocks(s.key === 'map' ? s.blocks.map(readableMap) : s.blocks) })),
    ),
  ]);
  const readable = readingUnits(tree.nodes);
  const rows = chapterRows(readable.map(unitOf), guide.journey);
  // Where a cite can open in place: every chapter, with the book's number for it.
  const units = readable.map((u) => ({ anchor: u.anchor, heading: u.heading ?? u.anchor, label: chapterLabel(u.anchor) }));
  const at = best.artifact.reviewed_at ?? best.artifact.created_at;
  return {
    doc,
    items,
    hasBrief,
    sheet: {
      sections,
      rows,
      units,
      themes: guide.themes,
      numbers: guide.numbers,
      glance: glance(guide, rows, doc.page_count),
      version: best.artifact.version,
      draft: best.standing !== 'approved',
      approvedOn:
        best.standing === 'approved' ? new Date(at).toLocaleDateString('en-GB', { day: 'numeric', month: 'long', year: 'numeric' }) : null,
    },
  };
});
if (!loaded.ok && loaded.notFound) Astro.response.status = 404;
const data = loaded.ok ? loaded.value : null;
---

<BaseLayout title={data ? `Guide: ${data.doc.title}` : 'Guide'} width="wide">
  {
    !data ? (
      !loaded.ok && loaded.notFound ? (
        <div class="empty">
          <h1>Not on the shelf</h1>
          <p>
            No document is called “{ref}”. <a href="/library">Back to the library</a>
          </p>
        </div>
      ) : (
        !loaded.ok && <Problem title="The guide could not be loaded." problem={loaded.problem} />
      )
    ) : data.sheet ? (
      <>
        <nav class="tools" aria-label="Guide">
          <a href={`/documents/${data.doc.slug}`}>Back to the document</a>
          <span class="tool-actions">
            {data.sheet.draft && (
              <a class="review workshop-only" href="/review">
                Review the draft
              </a>
            )}
            <button type="button" data-print>
              Print
            </button>
          </span>
        </nav>
        <div class="switch-bar">
          <StudySwitcher items={data.items} />
        </div>
        <GuideSheet
          slug={data.doc.slug}
          title={data.doc.title}
          authors={data.doc.authors}
          year={data.doc.year}
          sections={data.sheet.sections}
          rows={data.sheet.rows}
          units={data.sheet.units}
          themes={data.sheet.themes}
          numbers={data.sheet.numbers}
          glance={data.sheet.glance}
          approvedOn={data.sheet.approvedOn}
          version={data.sheet.version}
          draft={data.sheet.draft}
          hasBrief={data.hasBrief}
        />
      </>
    ) : (
      <div class="empty">
        <StudySwitcher items={data.items} />
        <p class="kind">Book guide</p>
        <h1>{data.doc.title} has no guide yet</h1>
        <p>
          The guide is written from the chapter distillations once every chapter has one, alongside the brief. To write it now,
          queue “Write the book guide” under Study material on the document page.
        </p>
        <p class="links">
          <a class="primary" href={`/documents/${data.doc.slug}`}>Back to the document</a>
        </p>
      </div>
    )
  }
</BaseLayout>

<script>
  for (const button of document.querySelectorAll<HTMLButtonElement>('[data-print]')) {
    button.addEventListener('click', () => window.print());
  }
</script>

<style>
  .tools {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: var(--space-4);
    max-width: 68rem;
    margin: 0 auto var(--space-4);
    font-family: var(--font-ui);
    font-size: var(--text-sm);
  }

  .tools a {
    color: var(--ink-3);
  }

  .tool-actions {
    display: flex;
    gap: var(--space-4);
    align-items: center;
  }

  .tools .review {
    color: var(--accent);
    font-weight: 600;
  }

  .tools button {
    min-block-size: 2.25rem;
    padding: var(--space-1) var(--space-4);
    border: 1px solid var(--rule-strong);
    border-radius: var(--radius-m);
    background: var(--paper-raised);
    color: var(--ink);
    cursor: pointer;
  }

  /* The same switcher as the study pages, between the toolbar and the sheet. */
  .switch-bar {
    max-width: 68rem;
    margin: 0 auto var(--space-5);
    padding-block: var(--space-2);
    border-block: 1px solid var(--rule);
  }

  .empty {
    display: grid;
    gap: var(--space-3);
    max-width: 40rem;
  }

  .kind {
    color: var(--accent);
    font-family: var(--font-ui);
    font-size: var(--text-sm);
    font-weight: 600;
  }

  .empty h1 {
    font-size: var(--text-xl);
  }

  .empty p {
    color: var(--ink-2);
  }

  .links {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-4);
    align-items: center;
    font-family: var(--font-ui);
    font-size: var(--text-ui);
  }

  .primary {
    padding: var(--space-2) var(--space-4);
    border-radius: var(--radius-m);
    background: var(--ink);
    color: var(--paper) !important;
    font-weight: 600;
    text-decoration: none;
  }

  @page {
    size: auto;
    margin: 14mm 16mm;
  }

  @media print {
    :global(:root) {
      color-scheme: light !important;
    }

    :global(.masthead),
    :global(.colophon),
    :global(.skip-link),
    .tools,
    .switch-bar {
      display: none !important;
    }

    :global(body) {
      display: block !important;
      background: #fff !important;
      color: #000 !important;
    }

    :global(main.main) {
      max-width: none !important;
      padding: 0 !important;
    }
  }
</style>
