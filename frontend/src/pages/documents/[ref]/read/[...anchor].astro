---
/**
 * Reader: `/documents/{ref}/read/{anchor?}`. Loads the chapter that contains the
 * anchor (the first real chapter when there is none), its artifacts, the book's notes
 * and vocabulary (concepts and glossary, for the what-matters marks), pre-renders code
 * and math, the chapter's recalls and whether it was ever opened (for the prediction
 * card), and hands everything to the reader island. A paper also brings its passes, unit
 * roles, claim marks, notation and review questions (components/reader/paper/load.ts).
 */
import BaseLayout from '../../../../layouts/BaseLayout.astro';
import Reader from '../../../../components/reader/Reader';
import { Problem } from '../../../../components/common/Problem';
import { lexiconFromArtifacts } from '../../../../components/reader/lexicon';
import { marksFromBody } from '../../../../components/reader/modelMarks';
import { buildPanes, paneEntries } from '../../../../components/reader/panes';
import { serverApi } from '../../../../lib/api/server';
import type { NodeSubtree, ReadingPosition } from '../../../../lib/api/types/documents';
import type { RecallPublic } from '../../../../lib/api/types/recalls';
import type { NoteDetail } from '../../../../lib/api/types/notes';
import { fetchAll } from '../../../../lib/api/fetch-all';
import { pickBest } from '../../../../lib/documents/artifacts';
import { getArtifacts, getDocument, getOutline, load } from '../../../../lib/documents/server';
import { defaultUnit, flatten, readingUnits, unitFor } from '../../../../lib/documents/tree';
import { isFinished } from '../../../../lib/documents/reading';
import { highlightCode } from '../../../../lib/highlight';
import { prepareBlocks } from '../../../../lib/prepare';
import { renderInlineMath } from '../../../../lib/katex';
import { loadPaperReading } from '../../../../components/reader/paper/load';
import { collectionParam } from '../../../../components/collections/path';
import { collectionOf } from '../../../../components/collections/load';

export const prerender = false;

const ref = Astro.params.ref ?? '';
const requested = Astro.params.anchor?.replace(/\/+$/, '') || null;
const collectionSlug = collectionParam(Astro.url.searchParams);

const loaded = await load(async () => {
  const doc = await getDocument(ref);
  const outline = await getOutline(doc.slug);
  const units = readingUnits(outline.nodes);
  const unit = requested ? unitFor(units, requested) : defaultUnit(units);
  if (!unit) return { doc, units, missing: true as const };
  const api = serverApi();
  const recallsPath = `documents/${encodeURIComponent(doc.slug)}/recalls`;
  const [subtree, artifacts, notes, conceptLinks, glossary, recalls, positions, paper, collection] = await Promise.all([
    api.get<NodeSubtree>(`nodes/${doc.slug}/${unit.anchor}`),
    getArtifacts(doc.id, { anchor_prefix: unit.anchor }),
    // The whole book's notes: the chapter's are shown in place, all of them in the notes list.
    fetchAll<NoteDetail>(api, 'notes', { document_id: doc.id }),
    getArtifacts(doc.id, { type: 'concept_links' }),
    getArtifacts(doc.id, { type: 'glossary' }),
    // Remembering it: best effort, the chapter reads without them.
    api.get<RecallPublic[]>(recallsPath, { query: { unit: unit.anchor } }).catch(() => []),
    api.get<ReadingPosition[]>(`documents/${encodeURIComponent(doc.slug)}/reading`).catch(() => null),
    doc.genre === 'paper'
      ? loadPaperReading({ api, slug: doc.slug, unit: unit.anchor, units, artifactsOf: (type) => getArtifacts(doc.id, { type }), renderMath: renderInlineMath })
      : Promise.resolve(null),
    collectionOf(collectionSlug, doc.id),
  ]);
  // Unknown (the call failed) counts as read: better no prediction card than a wrong one.
  const unread = positions !== null && !positions.some((p) => p.unit === unit.anchor);
  // Front matter counts as finished: it never holds up the end of the book.
  const finished = positions && [...positions.filter((p) => isFinished(p.progress)).map((p) => p.unit), ...units.filter((u) => u.meta.front_matter).map((u) => u.anchor)];
  const lexicon = lexiconFromArtifacts([...conceptLinks, ...glossary]);
  const flat = flatten(subtree.node);
  const headings = Object.fromEntries(
    flat.map(({ node }) => [node.anchor, node.heading ?? node.meta.caption ?? '']).filter(([, h]) => h),
  );
  const panes = buildPanes(artifacts, unit.anchor, headings);
  const modelMarks = marksFromBody(pickBest(artifacts, 'salience_marks', unit.anchor)?.artifact.body, flat.map(({ node }) => node));
  await Promise.all(
    paneEntries(panes).map(async (entry) => {
      entry.blocks = await prepareBlocks(entry.blocks);
    }),
  );
  const codeHtml: Record<string, string> = {};
  await Promise.all(
    flat
      .filter(({ node }) => node.kind === 'code' && node.text)
      .map(async ({ node }) => {
        const html = await highlightCode(node.text ?? '', node.meta.language ?? undefined);
        if (html) codeHtml[node.anchor] = html;
      }),
  );
  return { doc, units, missing: false as const, unit: subtree.node, truncated: subtree.truncated, panes, notes: notes.items, codeHtml, lexicon, modelMarks, recalls, unread, finished, paper, collection };
});

if (!loaded.ok && loaded.notFound) Astro.response.status = 404;
const data = loaded.ok ? loaded.value : null;
if (data?.missing) Astro.response.status = 404;
const navUnits = data
  ? data.units.map((u, i) => ({ anchor: u.anchor, heading: u.heading ?? `Chapter ${i + 1}` }))
  : [];
const title = data && !data.missing ? `${data.unit.heading ?? data.unit.anchor}, ${data.doc.title}` : 'Reader';
---

<BaseLayout title={title} width="wide">
  {
    !data ? (
      !loaded.ok && loaded.notFound ? (
        <div class="missing">
          <h1>Not on the shelf</h1>
          <p>No document is called “{ref}”. <a href="/library">Back to the library</a></p>
        </div>
      ) : (
        !loaded.ok && <Problem title="This chapter could not be loaded." problem={loaded.problem} />
      )
    ) : data.missing ? (
      <div class="missing">
        <h1>{requested ? 'No such passage' : 'Nothing to read yet'}</h1>
        <p>
          {requested
            ? `“${requested}” is not in ${data.doc.title}. It may have moved when the document was parsed again.`
            : `${data.doc.title} has no chapters yet. They appear once parsing finishes.`}{' '}
          <a href={`/documents/${data.doc.slug}`}>Open the document</a>
        </p>
      </div>
    ) : (
      <Reader
        client:load
        document={{ id: data.doc.id, slug: data.doc.slug, title: data.doc.title, language: data.doc.language }}
        unit={data.unit}
        units={navUnits}
        panes={data.panes}
        notes={data.notes}
        codeHtml={data.codeHtml}
        collection={data.collection}
        lexicon={data.lexicon}
        modelMarks={data.modelMarks}
        recalls={data.recalls}
        unread={data.unread}
        finished={data.finished}
        initialAnchor={requested}
        truncated={data.truncated}
        paper={data.paper}
      />
    )
  }
</BaseLayout>

<style>
  .missing {
    display: grid;
    gap: var(--space-3);
    max-width: 40rem;
  }
</style>
