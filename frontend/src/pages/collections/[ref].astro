---
/**
 * One collection: its books, papers and articles as a reading path (order, progress, a
 * note each), where to pick up, and the ways to look at it as a whole: the library
 * narrowed to it, its map, its concepts, and a search inside it. Reading a member from here
 * keeps the collection in the reader's URL, so the reader offers the next one.
 */
import BaseLayout from '../../layouts/BaseLayout.astro';
import { Problem } from '../../components/common/Problem';
import BoxSet from '../../components/collections/BoxSet.astro';
import CollectionDetails from '../../components/collections/CollectionDetails';
import CollectionPath, { type PathEntry, type ShelfEntry } from '../../components/collections/CollectionPath';
import { genreSummary, memberReading, memberShare, readHref, upNext } from '../../components/collections/path';
import { positionsReading } from '../../components/library/load';
import { fetchAll } from '../../lib/api/fetch-all';
import { serverApi } from '../../lib/api/server';
import type { DocumentSummary } from '../../lib/api/types/documents';
import { getCollection } from '../../lib/collections/api';
import { getShelfReading, load } from '../../lib/documents/server';

export const prerender = false;

const ref = Astro.params.ref ?? '';
const loaded = await load(async () => {
  const [collection, shelf, positions] = await Promise.all([
    getCollection(serverApi(), ref),
    fetchAll<DocumentSummary>(serverApi(), 'documents'),
    getShelfReading(),
  ]);
  const readings = collection.members.map((m) => positionsReading(m.document, positions));
  return { collection, shelf: shelf.items, readings };
});
if (!loaded.ok && loaded.notFound) Astro.response.status = 404;

const data = loaded.ok ? loaded.value : null;
const entry = (d: DocumentSummary): ShelfEntry => ({ id: d.id, slug: d.slug, title: d.title, authors: d.authors, genre: d.genre });
const members: PathEntry[] = data
  ? data.collection.members.map((m, i) => {
      const reading = data.readings[i] ?? { share: 0, lastRead: null, resume: null };
      return {
        ...entry(m.document),
        ...memberReading(reading, m.document.finished_at),
        resume: reading.resume,
        note: m.note,
      };
    })
  : [];
const next = upNext(members);
const slug = data?.collection.slug ?? ref;
const searchHref = `/search?${members.map((m) => `doc=${m.id}`).join('&')}`;
---

<BaseLayout title={data?.collection.name ?? 'Collection'} description={data?.collection.description ?? 'A collection of books, papers and articles.'}>
  {
    !data ? (
      <div class="missing">
        {!loaded.ok && loaded.notFound ? (
          <>
            <h1>No such collection</h1>
            <p>
              No collection is called “{ref}”. <a href="/collections">See every collection</a>
            </p>
          </>
        ) : (
          !loaded.ok && <Problem title="The collection could not be loaded." problem={loaded.problem} />
        )}
      </div>
    ) : (
      <article class="collection">
        <header class="head">
          <div class="title">
            <nav class="crumbs" aria-label="Breadcrumb">
              <a href="/collections">
                <span aria-hidden="true">←</span> Collections
              </a>
            </nav>
            <CollectionDetails client:load slug={slug} name={data.collection.name} description={data.collection.description} />
            <p class="summary">
              {genreSummary(members)}
              {members.length > 0 && <span>, {members.filter((m) => memberShare(m) >= 1).length} of {members.length} read</span>}
            </p>
          </div>
          <div class="floor">
            {next && (
              <a class="read" href={readHref(next.slug, slug, next.resume)}>
                <span class="read-how">
                  {memberShare(next) > 0 ? 'Continue with' : members.every((m) => memberShare(m) === 0) ? 'Start with' : 'Next up'}
                </span>
                <span class="read-where">{next.title}</span>
              </a>
            )}
            <BoxSet
              size="large"
              limit={18}
              next={next?.id ?? null}
              members={members.map((m) => ({ id: m.id, title: m.title, genre: m.genre, share: memberShare(m) }))}
            />
          </div>
        </header>

        <nav class="lenses" aria-label="Look at the collection as a whole">
          <a href={`/library?collection=${slug}`}>
            <strong>On the shelf</strong>
            <span>The library, narrowed to it</span>
          </a>
          <a href={`/map?collection=${slug}`}>
            <strong>Map</strong>
            <span>Its chapters and the ideas between them</span>
          </a>
          <a href={`/graph?collection=${slug}`}>
            <strong>Concepts</strong>
            <span>Every idea its documents name</span>
          </a>
          <a href={searchHref}>
            <strong>Search inside</strong>
            <span>Ask only these documents</span>
          </a>
        </nav>

        <section class="path" aria-labelledby="path-heading">
          <h2 id="path-heading">Reading path</h2>
          <CollectionPath client:visible collection={slug} members={members} shelf={data.shelf.map(entry)} />
        </section>
      </article>
    )
  }
</BaseLayout>

<style>
  .collection {
    display: grid;
    gap: var(--space-7);
    max-inline-size: 56rem;
  }

  .head {
    display: grid;
    gap: var(--space-5);
  }

  /* Where to pick up on the left, the set itself standing on the same floor on the right. */
  .floor {
    display: flex;
    gap: var(--space-5);
    align-items: end;
    justify-content: space-between;
  }

  .floor > :global(.box) {
    flex: none;
  }

  .title {
    display: grid;
    gap: var(--space-3);
    justify-items: start;
    min-inline-size: 0;
  }

  .title :global(h1) {
    font-family: var(--font-read);
    font-size: var(--text-3xl);
    font-weight: 560;
    letter-spacing: -0.035em;
    line-height: 0.95;
  }

  .crumbs,
  .summary {
    color: var(--ink-2);
    font-family: var(--font-ui);
    font-size: var(--text-sm);
  }

  .crumbs a {
    color: inherit;
    text-decoration: none;
  }

  /* A bookmark ribbon: ink, with the highlighter edge it shares with the spine up next. */
  .read {
    display: inline-grid;
    flex: 0 1 32rem;
    gap: var(--space-1);
    min-inline-size: 0;
    padding: var(--space-3) var(--space-6) var(--space-3) var(--space-4);
    border-inline-start: 6px solid var(--marker);
    clip-path: polygon(0 0, 100% 0, calc(100% - 1rem) 50%, 100% 100%, 0 100%);
    background: var(--accent);
    color: var(--on-accent);
    font-family: var(--font-ui);
    text-decoration: none;
    transition: padding var(--dur-2) var(--ease-turn);
  }

  .read:hover {
    padding-inline-end: var(--space-7);
  }

  .read-how {
    font-size: var(--text-sm);
    font-weight: 700;
  }

  .read-where {
    font-family: var(--font-read);
    font-size: var(--text-md);
    line-height: var(--leading-tight);
  }

  /* Index tabs: the four ways to open the set, cut into a divider's top edge. */
  .lenses {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(11rem, 1fr));
    gap: var(--space-1);
    border-block-end: 2px solid var(--ink);
  }

  .lenses a {
    display: grid;
    align-content: start;
    gap: var(--space-1);
    padding: var(--space-3) var(--space-4) var(--space-4);
    border: 1px solid var(--rule-strong);
    border-block-end: 0;
    border-radius: var(--radius-l) var(--radius-l) 0 0;
    background: var(--paper-sunken);
    color: var(--ink);
    font-family: var(--font-ui);
    font-size: var(--text-sm);
    text-decoration: none;
    transition:
      padding var(--dur-2) var(--ease-turn),
      background var(--dur-1) var(--ease-out);
  }

  .lenses a:hover,
  .lenses a:focus-visible {
    padding-block-start: var(--space-5);
    background: var(--paper-raised);
  }

  .lenses strong {
    font-size: var(--text-ui);
  }

  .lenses span {
    color: var(--ink-2);
  }

  .path {
    display: grid;
    gap: var(--space-4);
  }

  .path h2 {
    font-size: var(--text-lg);
    font-weight: 600;
  }

  .missing {
    display: grid;
    gap: var(--space-2);
  }

  @media (max-width: 40rem) {
    .floor {
      flex-wrap: wrap;
    }

    .floor > :global(.box) {
      order: -1;
      inline-size: 100%;
    }
  }
</style>
