# Frontend (Astro) settings, declared in astro.config.mjs `env.schema`.
#   cd frontend && cp .env.example .env
#
# Anything prefixed PUBLIC_ is inlined into the browser bundle. Never put a secret there.
# The backend has its own file: see backend/.env.example (BOOKSHELF_* settings).

# Display name for the app shell.
PUBLIC_APP_NAME="Bookshelf"

# Base URL of the backend API, including the version prefix. The browser never calls
# it directly: islands go through the same-origin /api proxy.
PUBLIC_API_URL="http://localhost:8000/api/v1"

# Optional: where the Astro server reaches the backend when that differs from
# PUBLIC_API_URL (containers, a private network). Server-only.
# API_INTERNAL_URL="http://backend:8000/api/v1"

# Server-only key the /api proxy sends as X-API-Key on writes. Must match the
# backend's BOOKSHELF_API_KEY; leave empty locally when the backend sets none.
API_SECRET=""

# ---------------------------------------------------------------------------
# Shared with the backend
# ---------------------------------------------------------------------------
# The backend also reads this file (before backend/.env, which wins) for a Qdrant
# server. Leave both unset to use the embedded store in .qdrant/.
# QDRANT_URL="https://<cluster>.cloud.qdrant.io:6333"
# QDRANT_API_KEY=""
