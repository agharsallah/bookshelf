# Env file for this repo, kept inside frontend/. Copy it, then fill in real values:
#   cd frontend && cp .env.example .env
#
# Consumers:
#   frontend/ -> Astro/Vite loads frontend/.env automatically (project root)
#   backend/  -> pydantic-settings reads `.env` relative to the process cwd, so run it
#                from this directory, or set env_file in backend/app/core/config.py
#                to ../frontend/.env
#
# Anything prefixed PUBLIC_ is inlined into the browser bundle. Never put a secret there.

# ---------------------------------------------------------------------------
# Frontend (Astro) — declared in frontend/astro.config.mjs `env.schema`
# ---------------------------------------------------------------------------

# Display name for the app shell.
PUBLIC_APP_NAME="Bookshelf"

# Base URL of the backend API, including the version prefix.
PUBLIC_API_URL="http://localhost:8000/api/v1"

# Server-only key the frontend sends as X-API-Key on mutating requests.
# Must match BOOKSHELF_API_KEY below. Leave empty locally.
API_SECRET=""

# ---------------------------------------------------------------------------
# Backend (FastAPI)
# ---------------------------------------------------------------------------

BOOKSHELF_ENVIRONMENT="local"            # local | staging | production | test
BOOKSHELF_API_PREFIX="/api/v1"
BOOKSHELF_DATABASE_URL="sqlite:///./bookshelf.db"
BOOKSHELF_DATABASE_ECHO="false"

# Comma-separated. Astro dev server runs on 4321.
BOOKSHELF_CORS_ORIGINS="http://localhost:4321"
BOOKSHELF_ALLOWED_HOSTS="*"

BOOKSHELF_MAX_REQUEST_BYTES="1048576"
BOOKSHELF_RATE_LIMIT_REQUESTS="120"
BOOKSHELF_RATE_LIMIT_WINDOW_SECONDS="60"

# When set, mutating requests must send X-API-Key. Required when ENVIRONMENT=production.
BOOKSHELF_API_KEY=""

BOOKSHELF_LOG_LEVEL="INFO"               # DEBUG | INFO | WARNING | ERROR
BOOKSHELF_LOG_JSON="true"

# Unset = docs served everywhere except production.
# BOOKSHELF_ENABLE_DOCS="false"

# ---------------------------------------------------------------------------
# Search / vectors
# ---------------------------------------------------------------------------

QDRANT_API_KEY=""
