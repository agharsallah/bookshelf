          },
          {
            "concept": "Normalisation",
            "shelf_concept": null
          }
        ],
        "search_terms": [
          "attention weights normalization",
          "softmax vs normalising by a sum"
        ],
        "next_question": [
          {
            "text": "What happens to the new shares if every passage gets the same trust score?",
            "cites": [
              "ch03/s01/m002"
            ]
          }
        ]
      }
    }
