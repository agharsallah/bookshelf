{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bookshelf.local/skills/write-audio-summary/schema.json",
  "title": "write-audio-summary output",
  "description": "A script to be spoken: a cast of 1-4 speakers, then sections of turns, each turn one speaker's words with the anchors they come from.",
  "type": "object",
  "required": ["title", "speakers", "sections"],
  "additionalProperties": false,
  "properties": {
    "title": {
      "type": "string",
      "minLength": 3,
      "maxLength": 120,
      "description": "The episode's title, as a listener would see it in a player."
    },
    "speakers": {
      "type": "array",
      "minItems": 1,
      "maxItems": 4,
      "description": "The cast, speaker 1 first. Exactly as many as the format has.",
      "items": {
        "type": "object",
        "required": ["role", "persona"],
        "additionalProperties": false,
        "properties": {
          "role": {"type": "string", "minLength": 2, "maxLength": 40},
          "persona": {"type": "string", "minLength": 8, "maxLength": 200}
        }
      }
    },
    "sections": {
      "type": "array",
      "minItems": 2,
      "maxItems": 12,
      "items": {
        "type": "object",
        "required": ["title", "turns"],
        "additionalProperties": false,
        "properties": {
          "title": {"type": "string", "minLength": 2, "maxLength": 80},
          "turns": {
            "type": "array",
            "minItems": 1,
            "maxItems": 120,
            "items": {
              "type": "object",
              "required": ["speaker", "text", "cites"],
              "additionalProperties": false,
              "properties": {
                "speaker": {"type": "integer", "minimum": 1, "maximum": 4},
                "text": {"type": "string", "minLength": 1, "maxLength": 1500},
                "cites": {
                  "type": "array",
                  "maxItems": 8,
                  "items": {"$ref": "https://bookshelf.local/contracts/render-blocks.schema.json#/$defs/anchor"}
                }
              }
            }
          }
        }
      }
    }
  }
}
