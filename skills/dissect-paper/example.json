{
  "tldr": [
    {
      "text": "Gated retrieval adapters score each retrieved passage before the reader sees it, improving exact match over FiD-base by 2.1 points on NQ and 3.4 on HotpotQA with a 40% smaller adapter.",
      "cites": [
        "fm01/p002",
        "ch04/s02/p001"
      ]
    }
  ],
  "question": [
    {
      "text": "Can an open-domain QA reader stop irrelevant retrieved passages from diluting its evidence, without a larger model?",
      "cites": [
        "ch01/p002"
      ]
    }
  ],
  "contributions": [
    {
      "kind": "method",
      "spans": [
        {
          "text": "A learned gate that weights each passage by its relevance to the question before reading.",
          "cites": [
            "ch01/p004",
            "ch03/s01/p002"
          ]
        }
      ]
    },
    {
      "kind": "result",
      "spans": [
