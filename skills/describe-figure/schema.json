{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bookshelf.local/skills/describe-figure/schema.json",
  "title": "describe-figure output",
  "description": "A figure transcribed by kind: chart -> chart (or table fallback), diagram -> diagram, table -> table, photo -> paragraph; plus caption, alt text, a cited takeaway and self-reported confidence.",
  "type": "object",
  "required": ["kind", "caption", "alt", "blocks", "takeaway", "confidence"],
  "additionalProperties": false,
  "properties": {
    "kind": { "enum": ["chart", "diagram", "table", "photo"] },
    "caption": { "type": "string", "minLength": 1, "maxLength": 1500 },
    "alt": { "type": "string", "minLength": 1, "maxLength": 600 },
    "blocks": {
      "type": "array",
      "minItems": 1,
      "maxItems": 6,
      "items": {
        "anyOf": [
          { "$ref": "https://bookshelf.local/contracts/render-blocks.schema.json#/$defs/paragraph" },
          { "$ref": "https://bookshelf.local/contracts/render-blocks.schema.json#/$defs/bullets" },
          { "$ref": "https://bookshelf.local/contracts/render-blocks.schema.json#/$defs/table" },
          { "$ref": "https://bookshelf.local/contracts/render-blocks.schema.json#/$defs/chart" },
          { "$ref": "https://bookshelf.local/contracts/render-blocks.schema.json#/$defs/diagram" }
        ]
      }
    },
    "takeaway": { "$ref": "https://bookshelf.local/contracts/render-blocks.schema.json#/$defs/span" },
    "confidence": { "$ref": "https://bookshelf.local/contracts/render-blocks.schema.json#/$defs/confidence" }
  },
  "allOf": [
    {
      "if": { "properties": { "kind": { "const": "chart" } } },
      "then": {
        "properties": {
          "blocks": {
            "contains": { "properties": { "type": { "enum": ["chart", "table"] } }, "required": ["type"] }
          }
        }
      }
    },
    {
      "if": { "properties": { "kind": { "const": "diagram" } } },
      "then": {
        "properties": {
          "blocks": { "contains": { "properties": { "type": { "enum": ["diagram", "paragraph"] } }, "required": ["type"] } }
        }
      }
    },
    {
      "if": { "properties": { "kind": { "const": "table" } } },
      "then": {
        "properties": {
          "blocks": { "contains": { "properties": { "type": { "const": "table" } }, "required": ["type"] } }
        }
      }
    },
    {
      "if": { "properties": { "kind": { "const": "photo" } } },
      "then": {
        "properties": {
          "blocks": {
            "contains": { "properties": { "type": { "const": "paragraph" } }, "required": ["type"] },
            "items": { "properties": { "type": { "enum": ["paragraph", "bullets"] } } }
          }
        }
      }
    }
  ]
}
