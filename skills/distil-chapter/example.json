{
  "blocks": [
    {
      "type": "callout",
      "tone": "important",
      "spans": [
        {
          "text": "Busyness is not productivity: beyond about 80% utilization, each extra percent of load buys a disproportionate amount of waiting.",
          "cites": [
            "ch03/s01/p004",
            "ch03/s01/f001"
          ]
        }
      ]
    },
    {
      "type": "diagram",
      "direction": "LR",
      "nodes": [
        {
          "id": "util",
          "label": "High utilization"
        },
        {
          "id": "var",
          "label": "Variability"
        },
        {
          "id": "wait",
          "label": "Waiting explodes"
        },
        {
          "id": "slack",
          "label": "15–20% slack"
        }
      ],
      "edges": [
        {
          "from": "util",
          "to": "wait",
          "label": "past ~80%"
        },
        {
          "from": "var",
          "to": "wait",
          "label": "multiplies"
        },
        {
          "from": "slack",
          "to": "util",
          "label": "caps"
        }
      ],
      "cites": [
        "ch03/s01/p004",
        "ch03/s02/p003",
        "ch03/s03/p006"
      ]
    },
    {
      "type": "heading",
      "level": 2,
      "text": "Why waiting explodes"
    },
    {
      "type": "paragraph",
      "spans": [
        {
          "text": "Waiting scales with utilization and variability together; either alone is survivable. ",
          "cites": [
            "ch03/s02/p003"
          ]
        },
        {
          "text": "At 90% utilization an item waits about nine times its service time.",
          "cites": [
            "ch03/s01/p004",
            "ch03/s01/f001"
          ]
        }
      ]
    },
    {
      "type": "heading",
      "level": 2,
      "text": "Slack as capacity"
    },
    {
      "type": "callout",
      "tone": "antipattern",
      "spans": [
        {
          "text": "Planning to 100% capacity: unplanned work has nowhere to go, so queues are guaranteed.",
          "cites": [
            "ch03/s03/p002"
          ]
        }
      ]
    },
    {
      "type": "callout",
      "tone": "remember",
      "spans": [
        {
          "text": "Keep 15–20% of capacity unallocated.",
          "cites": [
            "ch03/s03/p006"
          ]
        }
      ]
    },
    {
      "type": "heading",
      "level": 2,
      "text": "Putting it into practice"
    },
    {
      "type": "steps",
      "items": [
        [
          {
            "text": "Leave 15–20% of capacity unallocated when planning.",
            "cites": [
              "ch03/s03/p006"
            ]
          }
        ],
        [
          {
            "text": "Review utilization weekly and cut intake once it passes 80%.",
            "cites": [
              "ch03/s03/p007"
            ]
          }
        ]
      ]
    }
  ]
}
