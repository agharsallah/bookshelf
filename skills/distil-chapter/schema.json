{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bookshelf.local/skills/distil-chapter/schema.json",
  "title": "distil-chapter output",
  "description": "A chapter distillation: render blocks from the closed contract, every leaf span cited through the section notes' anchors.",
  "type": "object",
  "required": ["blocks"],
  "additionalProperties": false,
  "properties": {
    "blocks": {
      "allOf": [
        { "$ref": "https://bookshelf.local/contracts/render-blocks.schema.json#/$defs/blocks" },
        { "maxItems": 200 }
      ]
    }
  }
}
