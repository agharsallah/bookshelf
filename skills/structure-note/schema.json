{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bookshelf.local/skills/structure-note/schema.json",
  "title": "structure-note output",
  "description": "The user's note re-rendered as a few render blocks (optionally opening with the highlighted passage as a quote), plus kebab-case tags and lowercase concept names.",
  "type": "object",
  "required": ["blocks", "tags", "concepts"],
  "additionalProperties": false,
  "properties": {
    "blocks": {
      "type": "array",
      "minItems": 1,
      "maxItems": 20,
      "items": {
        "anyOf": [
          { "$ref": "https://bookshelf.local/contracts/render-blocks.schema.json#/$defs/quote" },
          { "$ref": "https://bookshelf.local/contracts/render-blocks.schema.json#/$defs/paragraph" },
          { "$ref": "https://bookshelf.local/contracts/render-blocks.schema.json#/$defs/bullets" },
          { "$ref": "https://bookshelf.local/contracts/render-blocks.schema.json#/$defs/steps" },
          { "$ref": "https://bookshelf.local/contracts/render-blocks.schema.json#/$defs/callout" }
        ]
      }
    },
    "tags": {
      "type": "array",
      "maxItems": 6,
      "uniqueItems": true,
      "items": { "type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$", "maxLength": 40 }
    },
    "concepts": {
      "type": "array",
      "maxItems": 5,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1, "maxLength": 120, "pattern": "^[^A-Z]+$" }
    }
  }
}
